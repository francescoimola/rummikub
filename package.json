{
  "name": "francescoimola",
  "version": "1.0.0",
  "description": "francescoimola.com — Eleventy rebuild",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "start": "npx @11ty/eleventy --serve",
    "build": "npx @11ty/eleventy",
    "clean": "rm -rf public",
    "optimize:video": "node scripts/optimize-videos.mjs",
    "compress:assets": "node scripts/compress-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "browserslist": "last 2 Chrome versions, last 3 Edge versions, last 2 Firefox versions, last 3 Safari versions",
  "license": "ISC",
  "dependencies": {
    "@11tyrocks/eleventy-plugin-sass-lightningcss": "^1.2.0",
    "lenis": "^1.3.25",
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^4.3.1",
    "utopia-core-scss": "^1.3.1"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "jsdom": "^27.2.0",
    "sharp": "^0.33.5",
    "vitest": "^4.1.9"
  }
}
