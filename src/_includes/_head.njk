<head>
  <meta charset="utf-8">
  <meta name="color-scheme" content="light dark">
  <script>
    // Apply stored palette/theme before first paint (no flash). Reconciled by look-toggles.js.
    (function () {
      try {
        var b = localStorage.getItem("brand");
        if (b) document.documentElement.setAttribute("data-brand", b);
        var t = localStorage.getItem("theme");
        if (t) document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    })();
  </script>
  {%- include "_meta.njk" -%}
  {%- include "_schema.njk" -%}

  {# Used verbatim, nothing appended — add "| Francesco Imola" in frontmatter where you want it. #}
  {# metaTitle wins where the h1 (title) needs to stay short, e.g. case studies. #}
  <title>{{ metaTitle | default(title) }}</title>

  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/Ronzino-Regular.woff2" crossorigin="anonymous">
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/Ronzino-Medium.woff2" crossorigin="anonymous">
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/Ronzino-Bold.woff2" crossorigin="anonymous">

  <link rel="preload" as="style" href="/css/index.css">
  <link rel="stylesheet" href="/css/index.css">

  <link rel="icon" type="image/svg+xml" href="/assets/favicon/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/assets/favicon/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png">
  <link rel="manifest" href="/assets/favicon/site.webmanifest">
</head>
