{# Artmaking row: text above a plain 2-up image grid (Q25, G37). Images keep their natural ratio. #}
{% macro splitRow(item) %}
<article class="split-row">
  <div class="split-row__text">
    <h2>{{ item.title }}</h2>
    <div class="flow has-gap-xs">
      <p>{{ item.description }}</p>
      {% if item.year %}<p class="dimmed">{{ item.year }}</p>{% endif %}
      {% if item.link %}
      {# only external links open in a new tab — internal ones (e.g. /writing/…) stay in place #}
      <a href="{{ item.link }}"{% if "http" in item.link %} target="_blank" rel="noopener noreferrer"{% endif %} data-icon="arrow-ext">{{ item.linkLabel | default("Visit " + item.title) }}</a>
      {% endif %}
    </div>
  </div>
  {% if item.images %}
  <ul class="grid-cols-2 split-row__images">
    {% for img in item.images %}
    <li class="card has-justify-start">
      <img src="{{ img.src }}" alt="{{ img.alt }}" sizes="(min-width: 32rem) 50vw, 100vw">
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</article>
{% endmacro %}
