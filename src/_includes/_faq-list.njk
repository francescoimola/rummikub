{# FAQ list from faqs.json (G26): independent <details> (no name=), <hr> between. Answers are Markdown. #}
{% macro faqList(items) %}
<div class="flow has-gap-s">
    {%- for item in items %}
    <details>
        <summary>{{ item.question }}</summary>
        <div class="faq-answer text flow has-gap-s">{{ item.answer | markdown | safe }}</div>
    </details>
    {%- if not loop.last %}
    <hr>
    {%- endif %}
    {%- endfor %}
</div>
{% endmacro %}
