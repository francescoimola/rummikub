{%- set isHomepage = page.url == '/' -%}
{%- set isWritingPost = tags and 'writing' in tags -%}
{%- set isWritingListing = page.url == '/writing/' -%}

{%- if isHomepage -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "{{ site.url }}/#person",
      "name": "{{ site.name }}",
      "url": "{{ site.url }}",
      "image": "{{ site.personImage }}",
      "description": "{{ site.description }}",
      "jobTitle": "Web Designer & Developer"
    },
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}",
      "name": "{{ site.name }}",
      "description": "{{ site.description }}",
      "publisher": { "@id": "{{ site.url }}/#person" },
      "inLanguage": "en-GB"
    },
    {
      "@type": "WebPage",
      "@id": "{{ site.url }}{{ page.url }}#webpage",
      "url": "{{ site.url }}{{ page.url }}",
      "name": "{{ title }}",
      "isPartOf": { "@id": "{{ site.url }}/#website" },
      "about": { "@id": "{{ site.url }}/#person" },
      "description": "{{ description | default(site.description) }}",
      "inLanguage": "en-GB"
    }
  ]
}
</script>
{%- endif -%}

{%- if isWritingPost and date -%}
{# Posts without an image: frontmatter fall back to the site default, else this emits a bare domain. #}
{%- set articleImage = image | default(site.image) -%}
{%- if '://' not in articleImage %}{% set articleImage = site.url + articleImage %}{% endif -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "description": "{{ teaser }}",
  "image": "{{ articleImage }}",
  "datePublished": "{{ date | dateToRfc3339 }}",
  "dateModified": "{{ date | dateToRfc3339 }}",
  "author": {
    "@type": "Person",
    "@id": "{{ site.url }}/#person",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}"
  },
  "publisher": {
    "@type": "Person",
    "@id": "{{ site.url }}/#person",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}{{ page.url }}"
  },
  "url": "{{ site.url }}{{ page.url }}",
  "inLanguage": "en-GB"
  {%- if type and writingTypes[type] %},
  "articleSection": "{{ writingTypes[type].label }}"
  {%- endif %}
}
</script>
{%- endif -%}

{%- if isWritingListing -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "{{ site.name }} — Writing",
  "description": "{{ site.description }}",
  "url": "{{ site.url }}/writing/",
  "publisher": {
    "@type": "Person",
    "@id": "{{ site.url }}/#person",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}"
  },
  "inLanguage": "en-GB"
}
</script>
{%- endif -%}

{%- if not isHomepage and not (isWritingPost and date) and not isWritingListing -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "{{ metaTitle | default(title) }}",
  "description": "{{ description | default(site.description) }}",
  "url": "{{ site.url }}{{ page.url }}",
  "publisher": {
    "@type": "Person",
    "@id": "{{ site.url }}/#person",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}"
  },
  "inLanguage": "en-GB"
}
</script>
{%- endif -%}
