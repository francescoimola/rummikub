{# compact (type pages) keeps the narrow 1fr 3fr thumb at every width #}
{# sizes tracks the thumb's real width (#76; CSS rem is the 15px root, sizes rem the 16px default). Type pages: 1/4 of main
   (≤234px) until main>* caps at 40rem from $bp-xl (≤138px). Index: 3/8 of the row, ≤252px while .section stacks (main < 48rem,
   viewport ≈ 47rem), 1/4 under main 32rem (viewport ≈ 32rem), ≤148px once it folds 2-up #}
{% macro writingItem(item, thumbColor, compact = false) %}
<a class="card writing-item{% if compact %} writing-item--compact{% endif %}"
   href="{{ item.data.external or item.url }}"
   {% if item.data.external %}target="_blank" rel="noopener noreferrer"{% endif %}>
  {% if item.data.image %}
  <span class="writing-item__thumb"><img src="{{ item.data.image }}" alt="{{ item.data.alt }}" loading="lazy" decoding="async" sizes="{{ '(min-width: 64rem) 10rem, 25vw' if compact else '(min-width: 48rem) 10rem, (min-width: 32rem) 37.5vw, 25vw' }}"></span>
  {% else %}
  <span class="writing-item__thumb" style="--thumb-fill: {{ thumbColor }}" aria-hidden="true"></span>
  {% endif %}
  <div class="writing-item__body flow has-gap-3xs">
    <h3 class="has-mb-3xs">{{ item.data.title }}</h3>
    {% if item.data.source %}
      <small data-icon="arrow-ext">{{ item.data.source }}</small>
    {% endif %}
    {% if item.date %}
      <time datetime="{{ item.date | isoMonth }}"><small>{{ item.date | monthYear }}</small></time>
    {% endif %}
  </div>
</a>
{% endmacro %}
