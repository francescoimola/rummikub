{% macro writingItem(item) %}
<a class="card writing-item flow-row has-gap-s-l"
   href="{{ item.data.external or item.url }}"
   {% if item.data.external %}target="_blank" rel="noopener noreferrer"{% endif %}>
  {% if item.data.image %}
  <span class="writing-item__thumb"><img src="{{ item.data.image }}" alt="{{ item.data.alt }}" loading="lazy" decoding="async" sizes="5rem"></span>
  {% else %}
  <span class="writing-item__thumb" style="--thumb-fill: {{ item | writingThumbColor }}" aria-hidden="true"></span>
  {% endif %}
  <div class="writing-item__body flow has-gap-2xs">
    {% if item.data.source %}<p class="writing-item__source dimmed">{{ item.data.source }} ↗</p>{% endif %}
    <div class="flow has-gap-l">
      <h3 class="trim-above">{{ item.data.title }}</h3>
      <small class="dimmed">{{ item.data.teaser }}</small>
    </div>
  </div>
</a>
{% endmacro %}
