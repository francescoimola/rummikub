{# Section hero: an optional illustration over the page's KC Pelletier h1, on the brand band (G16, G17). #}
{# pageHeader("", label) drops the drawing; label may carry inline markup such as <br>. #}
{% macro pageHeader(iconName, label) %}
<header class="page-header" view-animation="settle">
    {%- if iconName %}
    {% icon iconName %}
    {%- endif %}
    <h1>{{ label | safe }}</h1>
</header>
{% endmacro %}
