<!DOCTYPE html>
<html lang="en"{% if brand %} data-brand="{{ brand }}"{% endif %}>
{% include "_head.njk" %}
<body>
  <div class="layout"{% if contentMode == "contrast" %} data-content="contrast"{% endif %}>
    <aside class="sidebar">
      {%- include "_header.njk" -%}
      <div class="desktop-only flow-row has-gap-2xs has-items-end">
        {%- include "_footer.njk" -%}
        {%- include "_look-toggles.njk" -%}
      </div>
    </aside>
    <div class="content">
      {% if tags and "work" in tags %}
      <main class="case-study text">
        <div class="flow has-gap-3xs case-study__intro">
          <h1>{{ title }}</h1>
          {% if services %}<p class="dimmed">{{ services }}</p>{% endif %}
        </div>
        {{ content | safe }}
      </main>
      {% elif tags and "writing" in tags %}
      <main class="case-study text">
        <div class="card writing-hero" view-animation="settle">
          {% if image %}<img src="{{ image }}" alt="{{ alt }}" width="1080" height="auto">{% endif %}
          <div class="flow has-gap-2xs has-mt-s-m">
            <h1>{{ title }}</h1>
            <p class="dimmed">{{ date | longDate }}{% if type and writingTypes[type] %} · {{ writingTypes[type].short }}{% endif %}</p>
          </div>
          {% if note %}<p class="writing-item__note dimmed">{{ note }}</p>{% endif %}
        </div>
        {{ content | safe }}
      </main>
      {% elif isFullWidth %}
      <main class="flow-row has-gap-s-m" full-width>{{ content | safe }}</main>
      {% else %}
      <main class="flow has-gap-3xl">{{ content | safe }}</main>
      {% endif %}
      <div class="mobile-only">
        {%- include "_footer.njk" -%}
      </div>
    </div>
  </div>
  <script src="/assets/scripts/lenis.min.js"></script>
  <script src="/assets/scripts/lenis.js" defer></script>
  <script type="module" src="/assets/scripts/app-core.js"></script>
</body>
</html>
