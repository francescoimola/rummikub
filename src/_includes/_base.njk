<!DOCTYPE html>
<html lang="en"{% if brand %} data-brand="{{ brand }}"{% endif %}>
{% include "_head.njk" %}
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  {%- include "_header.njk" %}
  <div class="layout"{% if contentMode == "contrast" %} data-content="contrast"{% endif %}>
    {# longForm: true opts a standalone page (Accessibility) into the long-form shell, without the writing-post animations #}
    {% if longForm or (tags and ("work" in tags or "writing" in tags)) %}
    <main id="main-content" class="case-study text{% if tags and "writing" in tags %} writing-post{% endif %}">
      <div class="flow has-gap-3xs case-study__intro">
        <h1>{{ title }}</h1>
        {% if services %}<p class="dimmed">{{ services }}</p>
        {% elif tags and "writing" in tags and date %}<p class="dimmed"><time datetime="{{ date | isoMonth }}">{{ date | longDate }}</time>{% if type and writingTypes[type] %} · {{ writingTypes[type].short }}{% endif %}</p>
        {% elif longForm and updated %}<p class="dimmed">Last updated <time datetime="{{ updated.toISOString().slice(0, 10) }}">{{ updated | longDate }}</time></p>{% endif %}
      </div>
      {{ content | safe }}
    </main>
    {% elif isFullWidth %}
    <main id="main-content" class="flow-row has-gap-s-m" full-width>{{ content | safe }}</main>
    {% else %}
    <main id="main-content" class="flow has-gap-xl-2xl">{{ content | safe }}</main>
    {% endif %}
  </div>
  {%- include "_footer.njk" %}
  <script src="/assets/scripts/lenis.min.js"></script>
  <script src="/assets/scripts/lenis.js" defer></script>
  <script type="module" src="/assets/scripts/app-core.js"></script>
  {%- if eleventy.env.runMode == "serve" %}
  <script type="module" src="/assets/dev/focal-picker.js"></script>
  {%- endif %}
</body>
</html>
