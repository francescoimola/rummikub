<!DOCTYPE html>
<html lang="en"{% if brand %} data-brand="{{ brand }}"{% endif %}>
{% include "_head.njk" %}
<body>
  <div class="layout"{% if contentMode == "contrast" %} data-content="contrast"{% endif %}>
    <aside class="sidebar">
      {%- include "_header.njk" -%}
      <div class="desktop-only flow-row has-gap-2xs has-items-end">
        {%- include "_footer.njk" -%}
        {%- include "_look-toggles.njk" -%}
      </div>
    </aside>
    <div class="content">
      <main {% if isFullWidth %}class="flow-row has-gap-s-m" full-width{% else %}class="flow has-gap-3xl"{% endif %}>{{ content | safe }}</main>
      <div class="mobile-only">{%- include "_footer.njk" -%}</div>
    </div>
  </div>
  <script src="/assets/scripts/lenis.min.js"></script>
  <script src="/assets/scripts/lenis.js" defer></script>
  <script type="module" src="/assets/scripts/app-core.js"></script>
</body>
</html>
