<!DOCTYPE html>
<html lang="en"{% if brand %} data-brand="{{ brand }}"{% endif %}>
{% include "_head.njk" %}
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <div class="layout"{% if contentMode == "contrast" %} data-content="contrast"{% endif %}>
    {# Stays a div: the banner is the <header> inside _header.njk, which cannot contain this <footer>. #}
    <div class="sidebar">
      {%- include "_header.njk" -%}
      <div class="desktop-only flow-row has-gap-2xs has-mt-xl has-items-end">
        {%- include "_footer.njk" -%}
        {%- include "_look-toggles.njk" -%}
      </div>
    </div>
    <div class="content">
      {% if tags and ("work" in tags or "writing" in tags) %}
      <main id="main-content" class="case-study text{% if "writing" in tags %} writing-post{% endif %}">
        <div class="flow has-gap-3xs case-study__intro">
          <h1>{{ title }}</h1>
          {% if services %}<p class="dimmed">{{ services }}</p>
          {% elif "writing" in tags and date %}<p class="dimmed"><time datetime="{{ date | isoMonth }}">{{ date | longDate }}</time>{% if type and writingTypes[type] %} · {{ writingTypes[type].short }}{% endif %}</p>{% endif %}
        </div>
        {{ content | safe }}
      </main>
      {% elif isFullWidth %}
      <main id="main-content" class="flow-row has-gap-s-m" full-width>{{ content | safe }}</main>
      {% else %}
      <main id="main-content" class="flow has-gap-3xl">{{ content | safe }}</main>
      {% endif %}
      <div class="mobile-only">
        {%- include "_footer.njk" -%}
      </div>
    </div>
  </div>
  <script src="/assets/scripts/lenis.min.js"></script>
  <script src="/assets/scripts/lenis.js" defer></script>
  <script type="module" src="/assets/scripts/app-core.js"></script>
</body>
</html>
