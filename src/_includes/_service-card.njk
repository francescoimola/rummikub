{# Default: the whole card links to a service page; a .has-counter parent numbers its h3. Accordion: a plain <details> like faqList (the page puts <hr> between); CTA glyph follows the link type (G22). #}
{% macro serviceCard(title, url, description, type = "default", cta = "Enquire") %}
{% if type == "accordion" %}
<details>
    <summary><h3>{{ title }}</h3></summary>
    <div class="flow has-gap-xs has-py-xs balance">
        <p>{{ description }}</p>
        {% if url.startsWith("http") %}
        <a data-icon="arrow-ext" href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ cta }}</a>
        {% else %}
        <a data-icon="email" href="{{ url }}">{{ cta }}</a>
        {% endif %}
    </div>
</details>
{% else %}
<a href="{{ url }}" class="card flow link-card has-gap-xs balance">
    {# The service card keeps its deliberate big gap under the title, a named exception to the card rhythm #}
    <h3 class="has-pb-2xl">{{ title }}</h3>
    <p>{{ description }}</p>
    <span data-icon="arrow-right">Learn more</span>
</a>
{% endif %}
{% endmacro %}
