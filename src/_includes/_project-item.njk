{# layout="stacked": image above text at every width (homepage Featured). Default is Split: image beside text once the item's column is wide enough #}
{% macro projectItem(title, services, image, alt, url="", ratio="", layout="") %}
<article class="project-item{% if layout == "stacked" %} project-item--stacked{% endif %}">
  {% if url %}<a class="project-item__media" href="{{ url }}">{% endif %}
    <img class="project-item__img" src="{{ image }}" alt="{{ alt }}"{{ ratio | mediaStyle | safe }}>
  {% if url %}</a>{% endif %}
  <div class="flow has-gap-3xs">
      <h2>{{ title }}</h2>
      <p class="project-item__services">{{ services }}</p>
    {% if url %}
    <a class="project-item__cta" href="{{ url }}">Read case study</a>
    {% endif %}
  </div>
</article>
{% endmacro %}
