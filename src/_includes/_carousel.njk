{# Explorations carousel (G14): a scroll-snap strip. Prev/next are ::scroll-button() where supported; #}
{# elsewhere app-core.js reveals one fixed Previous/Next pair under the strip, which also swipes, scrolls and takes the keyboard (tabindex). #}
{# Slides crop to 3:2 (G45). #}
{% macro carousel(slides, label) %}
<section class="carousel" aria-roledescription="carousel" aria-label="{{ label }}">
    <ul class="carousel__track" tabindex="0" role="list">
        {%- for slide in slides %}
        <li aria-roledescription="slide" aria-label="{{ loop.index }} of {{ loop.length }}"><img src="{{ slide.src }}" alt="{{ slide.alt }}" loading="lazy"></li>
        {%- endfor %}
    </ul>
    <p class="carousel__links" hidden>
        <button type="button" data-carousel-prev aria-label="Previous image">Previous</button>
        <button type="button" data-carousel-next aria-label="Next image">Next</button>
    </p>
</section>
{% endmacro %}
