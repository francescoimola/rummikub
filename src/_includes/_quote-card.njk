{# Testimonial: quote, then name and role (G27, G28). Entries come from src/_data/testimonials.json (Pages CMS). #}
{# With linkLabel it's the company after the role; with linkUrl alone the name itself links. #}
{% macro quoteCard(t) %}
{%- set ext %} target="_blank" rel="noopener noreferrer" data-icon="arrow-ext"{% endset -%}
<figure class="card outline flow has-gap-s">
    <blockquote>
        <p>{{ t.quote }}</p>
    </blockquote>
    <figcaption>
        {%- if t.linkUrl and not t.linkLabel %}<a href="{{ t.linkUrl }}"{{ ext | safe }}>{{ t.name }}</a>{% else %}{{ t.name }}{% endif %}<br>
        {{- t.role }}{% if t.linkUrl and t.linkLabel %}, <a href="{{ t.linkUrl }}"{{ ext | safe }}>{{ t.linkLabel }}</a>{% endif -%}
    </figcaption>
</figure>
{% endmacro %}
