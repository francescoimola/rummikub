{# _header.njk #}
{# The page banner: one nav, one link list and one look-toggles instance serve both layouts. #}
{# Narrow: the <details> is the "Menu +" disclosure. Wide (_responsive.scss): the bar hides and the panel is forced open. #}
{# `header: minimal` (Collaborate, Accessibility, 404): no <nav>, a single link isn't navigation. #}
{%- set url = page.url or "" -%}
{%- macro navItem(href, label, current) -%}
<li><a href="{{ href }}"{% if current %} aria-current="page"{% endif %}>{{ label }}</a></li>
{%- endmacro -%}
{%- if header == "minimal" %}
<header class="site-banner site-banner--minimal">
<div class="site-banner__inner">
    <a href="/" class="site-banner__name">Francesco Imola</a>
    <details class="nav-menu">
        <summary class="nav-menu__bar">Menu <i class="nav-menu__icon" data-icon-before="plus" aria-hidden="true"></i></summary>
        <div class="nav-menu__panel">
            <div class="nav-menu__toggles">
                {%- include "_look-toggles.njk" -%}
            </div>
            <a href="/" class="nav-menu__exit" data-icon="arrow-right">To main site</a>
        </div>
    </details>
</div>
</header>
{%- else %}
<header class="site-banner">
<nav aria-label="Primary" class="site-banner__inner">
    <a href="/" class="site-banner__name">Francesco Imola</a>
    <details class="nav-menu">
        <summary class="nav-menu__bar">Menu <i class="nav-menu__icon" data-icon-before="plus" aria-hidden="true"></i></summary>
        <div class="nav-menu__panel">
            <ul>
                {{ navItem("/", "Start here", url == "/") }}
                {{ navItem("/studio/", "Work with me", url.indexOf("/studio/") == 0) }}
                {{ navItem("/writing/", "Ideas", url.indexOf("/writing/") == 0) }}
                {{ navItem("/art/", "Artmaking", url == "/art/") }}
                {{ navItem("/about/", "About", url == "/about/") }}
                {{ navItem("#contact", "Say hello", false) }}
            </ul>
            <div class="nav-menu__toggles">
                {%- include "_look-toggles.njk" -%}
            </div>
        </div>
    </details>
</nav>
</header>
{%- endif %}
