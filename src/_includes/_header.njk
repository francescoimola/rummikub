{# _header.njk #}
{# The page banner. Wraps the nav rather than .sidebar: <header> may not contain the sidebar's <footer>. #}
{# It is the sidebar's first flex child, in the nav's old place, so the two-child space-between holds. #}
<header class="site-banner">
<nav aria-label="Primary">
    <a href="/" class="desktop-only">Francesco Imola</a>
    <details class="nav-menu">
        <summary class="nav-menu__bar">
            <span class="mobile-only" aria-hidden="true">Francesco Imola</span>
            <span class="nav-menu__label mobile-only">Menu <i class="nav-menu__icon" aria-hidden="true"></i></span>
        </summary>
        <div class="nav-menu__panel">
            <ul class="flow">
                <li><a href="/"{{ ' aria-current="page"' | safe if page.url == '/' }}>Home</a></li>
                <li><a href="/studio/"{{ ' aria-current="page"' | safe if page.url == '/studio/' }}>Design Studio</a></li>
                <li><a href="/work/"{{ ' aria-current="page"' | safe if page.url == '/work/' }}>Selected Work</a></li>
                <li><a href="/writing/"{{ ' aria-current="page"' | safe if page.url == '/writing/' }}>Writing</a></li>
                <li><a href="/art/"{{ ' aria-current="page"' | safe if page.url == '/art/' }}>Artmaking</a></li>
                <li><a href="/about/"{{ ' aria-current="page"' | safe if page.url == '/about/' }}>About</a></li>
                <li><a href="/contact/"{{ ' aria-current="page"' | safe if page.url == '/contact/' }}>Contact</a></li>
            </ul>
            <div class="nav-menu__toggles mobile-only flow has-gap-xs">
                {%- include "_look-toggles.njk" -%}
            </div>
        </div>
    </details>
</nav>
</header>