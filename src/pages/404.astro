---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading";
import { Text, Flex, Box, Section } from "@radix-ui/themes";
import { ButtonLink } from "../components/ButtonLink";
import { MainGrid } from "../components/MainGrid";
import { InnerSection } from "../components/InnerSection";
import { ArrowLeftIcon } from "@radix-ui/react-icons";
import { SEO } from "../constants";
---

<Layout
    title={SEO.pages.notFound.title}
    description={SEO.pages.notFound.description}
    backgroundColor="var(--gray-3)"
>
    <PageHeading slot="heading" className="page-heading">
        Page not found
    </PageHeading>
    <Box slot="description">
        <Text size="3" as="p" wrap="pretty">
            The page you're looking for doesn't exist or has been moved.
        </Text>
    </Box>
    <Section
        slot="page-content"
        pt="0"
        style={{ backgroundColor: "var(--gray-1)" }}
    >
        <MainGrid>
            <InnerSection
                title="What now?"
                sectionId="what-now"
                showCounter={false}
            >
                <Flex direction="column" gap="4">
                    <Text size="3" as="p" wrap="pretty">
                        You can head back to the homepage or explore some of the
                        pages below.
                    </Text>
                    <Flex gap="3" wrap="wrap">
                        <ButtonLink
                            href="/"
                            size="3"
                            color="gray"
                            variant="soft"
                        >
                            <ArrowLeftIcon /> Go home
                        </ButtonLink>
                        <ButtonLink
                            href="/about"
                            size="3"
                            color="gray"
                            variant="outline"
                        >
                            About me
                        </ButtonLink>
                        <ButtonLink
                            href="/work"
                            size="3"
                            color="gray"
                            variant="outline"
                        >
                            View my work
                        </ButtonLink>
                    </Flex>
                </Flex>
            </InnerSection>
        </MainGrid>
    </Section>
</Layout>
