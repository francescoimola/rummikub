---
export const prerender = true;

import { getCollection, type CollectionEntry } from "astro:content";
import { Flex, Grid, Section, Text, Box, Theme, Link } from "@radix-ui/themes";
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading";
import ProjectImage from "../components/project/ProjectImage.astro";
import { InnerSection } from "../components/InnerSection";
import { MainGrid } from "../components/MainGrid";
import { KeyServicePoints, KSP } from "../components/KeyServicePoints";
import { BottomCTA } from "../components/BottomCTA";
import { ButtonLink } from "../components/ButtonLink";
import { CopyEmailButton } from "../components/CopyEmailButton";
import { SEO, SITE_DATA } from "../constants";

// Reorder this array to change the sequence of featured projects.
const projectOrder = [
    "the-loft",
    "not-bad",
    "the-collective",
    "blueberry",
    "mega-seating-plan",
    "folks-directory",
    "folkestone-bookshop",
];

// Fetch and order projects
const projects = await getCollection(
    "projects",
    ({ data }: CollectionEntry<"projects">) => projectOrder.includes(data.slug),
);
const featuredProjects = projectOrder
    .map((slug) =>
        projects.find((p: { data: { slug: string } }) => p.data.slug === slug),
    )
    .filter((p): p is NonNullable<typeof p> => !!p);

const capabilities = [
    {
        heading: "Website design & development",
        text: "I make building great sites from messy briefs look easy. Bilingual in Figma, Webflow, Framer, HTML and CSS.",
    },
    {
        heading: "Copywriting & content research",
        text: "As long as you're willing for me to taint your name with odd lexicon and inaccurate sentence structure, I'm in",
    },
    {
        heading: "Email marketing",
        text: "Big big fan of welcome emails, automations, and hyper-personalized campaigns. Quality > quantity.",
    },
    {
        heading: "Graphic design",
        text: "Top of the range rectangles and circles, sure, but really be prepared to have long chats about the meaning of life.",
    },
];
---

<Layout
    title={SEO.pages.collaborate.title}
    description={SEO.pages.collaborate.description}
    backgroundColor="var(--yellow-4)"
    roleFullWidth
>
    <!-- Hero -->
    <PageHeading slot="heading"
        >Hello, I'm Francesco</PageHeading
    >

    <Flex slot="description" direction="column" gap="4">
        <Text size="3" as="p" wrap="pretty"
            >Web and content designer. Strong on UX, copy, brand messaging, marketing operations, and the
        often unfashionable work of being reliable.
    </Text>
        <Text size="3" as="p" wrap="pretty"
            >Born in Italy, based in Folkestone, I take on project work for
            small businesses, white-label briefs from agencies, and I'll
            consider an in-house role when the fit's right. The sections below
            cover what I've made. If you want the marketing pitch, it's on the
            homepage.</Text
        >
    </Flex>

    <Box slot="role" asChild>
        <Text
            size="3"
            as="p"
            weight="medium"
            style={{ fontFamily: "var(--space-mono)" }}
        >
            🎧 Currently listening to
            <Link
                href="https://bloodorangenyc.bandcamp.com/track/time-will-tell"
                ><i>Time Will Tell</i> by Blood Orange</Link
            >
        </Text>
    </Box>

    <!-- Page Content -->
    <Section slot="page-content" asChild pt="0">
        <Theme
            appearance="light"
            accentColor="yellow"
            radius="none"
            grayColor="olive"
            style={{ backgroundColor: "var(--gray-1)" }}
        >
            <MainGrid>
                <!-- Capabilities -->
                <InnerSection title="What I do">
                    <KeyServicePoints>
                        {
                            capabilities.map((capability) => (
                                <KSP heading={capability.heading}>
                                    {capability.text}
                                </KSP>
                            ))
                        }
                    </KeyServicePoints>
                </InnerSection>

                <!-- Featured Projects -->
                <InnerSection title="Selected work">
                    <Grid columns="1" gapY="9">
                        {
                            featuredProjects.map(({ data }) => {
                                const href = data.caseStudyStatus
                                    ? undefined
                                    : `/work/${data.slug}`;

                                return (
                                    <Flex direction="column" gap="5">
                                        <ProjectImage
                                            src={data.coverImage}
                                            alt={data.coverAlt}
                                            cardTitle={data.title}
                                            skills={data.skills}
                                            href={href}
                                            caseStudyStatus={
                                                data.caseStudyStatus
                                            }
                                        />
                                        {data.heroDescription && (
                                            <Text size="3" as="p" wrap="pretty">
                                                {data.heroDescription}
                                            </Text>
                                        )}
                                        {href && (
                                            <ButtonLink
                                                href={href}
                                                variant="soft"
                                                color="gray"
                                                size="2"
                                                style={{
                                                    alignSelf: "flex-start",
                                                }}
                                            >
                                                Read case study
                                            </ButtonLink>
                                        )}
                                    </Flex>
                                );
                            })
                        }
                        <ButtonLink
                            href="/work"
                            variant="outline"
                            size="3"
                            style={{
                                width: "fit-content",
                            }}
                        >
                            See more projects
                        </ButtonLink>
                    </Grid>
                </InnerSection>
                <InnerSection title="What I'm looking for">
                    <Flex direction="column" gap="4">
                        <Text size="3" as="p" wrap="pretty">
            I enjoy working with talented people who are deeply passionate about what they do. Found yourself in uncharted waters? We'll navigate them together. Is your design team under pressure? I can be the release valve. Is your marketing department struggling to agree on what needs to be done? I may not have all the answers, but I’ll support them as they search for them.
          </Text>
            <Text size="3" as="p" wrap="pretty">
              Depending on your needs, I’m open to part-time, freelance or full-time opportunities. If you need someone to help you block out the noise and show you how to achieve more with less, I’m your guy.
          </Text>
                    </Flex>
                </InnerSection>
            </MainGrid>
        </Theme>
    </Section>

    <!-- Closing -->
    <BottomCTA
        client:visible
        slot="bottom-cta"
        backgroundColor="var(--yellow-3)"
        heading="What's the catch?"
        text="There's no catch. Say hello, and maybe we'll grab a coffee if you're nearby."
    >
        <Flex direction="column" gap="3" align="center">
            <ButtonLink
                variant="surface"
                href={`mailto:${SITE_DATA.email}`}
                size="3"
            >
                {SITE_DATA.email}
            </ButtonLink>
            <Text size="2" color="gray" trim="both">
                or click here to <CopyEmailButton
                    client:visible
                    email={SITE_DATA.email}
                    variant="ghost"
                    style={{
                        margin: "unset",
                        padding: "unset",
                        height: "auto",
                        verticalAlign: "baseline",
                        cursor: "pointer",
                        textDecoration: "underline",
                    }}>copy my email</CopyEmailButton
                >
            </Text>
        </Flex>
    </BottomCTA>
</Layout>
