---
export const prerender = true;

import { Flex, Text } from "@radix-ui/themes";
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading.tsx";
import { GoBackButton } from "../components/GoBackButton.tsx";
import { SEO } from "../constants.ts";
---

<Layout
    title={SEO.pages.comingSoon.title}
    description={SEO.pages.comingSoon.description}
    backgroundColor="var(--gray-3)"
    noIndex
>
    <!-- Hero -->
    <PageHeading slot="heading">Not quite there yet</PageHeading>

    <Flex slot="description" direction="column" gap="6">
        <Text size="3" as="p" wrap="pretty">
            This page isn't ready yet, but it will be soon. I'm working on the
            final touches as you read this. Thanks for visiting. In the
            meantime, there's plenty to see elsewhere on the site.
        </Text>
        <GoBackButton
            client:visible
            size="3"
            color="gray"
            variant="solid"
            style={{ alignSelf: "flex-start" }}
        />
    </Flex>
</Layout>
