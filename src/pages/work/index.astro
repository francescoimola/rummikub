---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import PageHeading from "../../components/PageHeading";
import ProjectImage from "../../components/project/ProjectImage.astro";
import { Text, Flex, Grid, Section, Theme } from "@radix-ui/themes";
import { InnerSection } from "../../components/InnerSection";
import { MainGrid } from "../../components/MainGrid";
import { getAllPublishedProjects } from "../../utils/getAllPublishedProjects";
import { SEO } from "../../constants";
import JsonLd from "../../components/JsonLd.astro";

const projects = await getAllPublishedProjects();
---

<Layout
    title={SEO.pages.work.title}
    description={SEO.pages.work.description}
    backgroundColor="var(--brand-surface-dark-mustard)"
    appearance="dark"
    roleFullWidth
    noMobileRole
>
    <Fragment slot="structured-data">
        <JsonLd
            data={{
                "@type": "CollectionPage",
                name: "Selected Work",
                description: SEO.pages.work.description,
                author: SEO.person,
            }}
        />
    </Fragment>

    <!-- Slot: Main Heading -->
    <PageHeading slot="heading">Selected Work</PageHeading>

    <!-- Slot: Description/Subtitle -->
    <Flex slot="description" direction="column" gap="5">
        <Text size="3"
            >I've been working at the infamous roundabout where marketing and
            design perpetually chase each other, and I've been doing so for
            roughly five years. I focus on digital products and marketing
            campaigns for confident businesses, non-profits and entrepreneurs.
            Below is a selection of projects I have worked on, ordered by
            recency.
        </Text>
    </Flex>

    <!-- Page Content -->
    <Section slot="page-content" asChild pt="0">
        <Theme
            appearance="light"
            accentColor="orange"
            radius="none"
            grayColor="olive"
            style={{ backgroundColor: "var(--gray-1)" }}
        >
            <MainGrid>
                <InnerSection title="Projects" showCounter={false}>
                    <Grid columns="1" gapY="var(--space-11)" mb="4">
                        {
                            projects.map((project) => (
                                <ProjectImage
                                    src={project.data.coverImage}
                                    alt={project.data.coverAlt}
                                    cardTitle={project.data.title}
                                    skills={project.data.skills ?? []}
                                    href={
                                        project.data.caseStudyStatus
                                            ? undefined
                                            : `/work/${project.data.slug}`
                                    }
                                    caseStudyStatus={
                                        project.data.caseStudyStatus
                                    }
                                />
                            ))
                        }
                    </Grid>
                </InnerSection>
            </MainGrid>
        </Theme>
    </Section>
</Layout>
