---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading";
import ProjectCanvas from "../components/project/ProjectCanvas.astro";
import { Text, Flex, Grid, Section, Theme } from "@radix-ui/themes";

import { InnerSection } from "../components/InnerSection";
import { MainGrid } from "../components/MainGrid";
import { KeyServicePoints, KSP } from "../components/KeyServicePoints";
import { BottomCTA } from "../components/BottomCTA";
import { ButtonLink } from "../components/ButtonLink";
import { CopyEmailButton } from "../components/CopyEmailButton";
import { getCollection } from "astro:content";
import { SEO, SITE_DATA } from "../constants";

// ── Project display order ──────────────────────────────────────
// Reorder this array to change the sequence of featured projects.
const projectOrder = [
    "thecollective",
    "blueberry",
    "makeandmind",
    "megaseatingplan",
    "thefolkestonebookshop",
];

// Fetch and order projects
const allProjects = await getCollection("projects");
const featuredProjects = projectOrder
    .map((slug) => allProjects.find((p) => p.data.slug === slug))
    .filter((p): p is NonNullable<typeof p> => !!p);
---

<Layout
    title={SEO.pages.workWithMe.title}
    description={SEO.pages.workWithMe.description}
    noIndex
    roleFullWidth
>
    <!-- Hero -->
    <PageHeading slot="heading">I make things simpler for a living</PageHeading>

    <Flex slot="description" direction="column" gap="4">
        <Text size="3" as="p" wrap="pretty">
            I'm a designer, writer, and strategist. My obsession is peanut
            butter and products so good they don't need any marketing.
            Unfortunately, not everyone is as lucky with what they're selling.
            So that's where I come in. I help brands to simplify, to hold space
            for big ideas, and to make them happen.
        </Text>
        <Text size="3" as="p" wrap="pretty">
            I'm proud to do work that helps people make informed choices. And I
            believe design, marketing, and all that is to do with long-term
            relationship-building can play a massive role in that.
        </Text>
    </Flex>

    <!-- Page Content -->
    <Section slot="page-content" asChild pt="0">
        <Theme
            appearance="light"
            accentColor="yellow"
            radius="none"
            grayColor="olive"
            style={{ backgroundColor: "var(--gray-1)" }}
        >
            <MainGrid>
                <!-- Capabilities -->
                <InnerSection title="What I do">
                    <KeyServicePoints>
                        <KSP heading="Web design & no-code development">
                            I make building great sites from messy briefs look
                            easy. Bilingual in Figma, Webflow, Framer, HTML and
                            CSS.
                        </KSP>
                        <KSP heading="Copywriting & content research">
                            As long as you're willing for me to taint your name
                            with odd lexicon and inaccurate sentence structure,
                            I'm in
                        </KSP>
                        <KSP heading="Email marketing">
                            Big big fan of welcome emails, automations, and
                            hyper-personalized campaigns. Quality > quantity.
                        </KSP>
                        <KSP heading="Graphic design">
                            Top of the range rectangles and circles, sure, but
                            really be prepared to have long chats about the
                            meaning of life.
                        </KSP>
                    </KeyServicePoints>
                </InnerSection>

                <!-- Featured Projects -->
                <InnerSection title="Selected work">
                    <Grid columns="1" gapY="9">
                        {
                            featuredProjects.map(({ data }) => {
                                const href = data.caseStudyStatus
                                    ? undefined
                                    : `/work/${data.slug}`;

                                return (
                                    <Flex direction="column" gap="5">
                                        <ProjectCanvas
                                            images={data.coverImages}
                                            layout={data.coverLayout}
                                            title={data.title}
                                            skills={data.skills || []}
                                            href={href}
                                            caseStudyStatus={
                                                data.caseStudyStatus
                                            }
                                        />
                                        {data.heroDescription && (
                                            <Text size="3" as="p" wrap="pretty">
                                                {data.heroDescription}
                                            </Text>
                                        )}
                                        {href && (
                                            <ButtonLink
                                                href={href}
                                                variant="soft"
                                                color="gray"
                                                size="2"
                                                style={{
                                                    alignSelf: "flex-start",
                                                }}
                                            >
                                                Read case study
                                            </ButtonLink>
                                        )}
                                    </Flex>
                                );
                            })
                        }
                        <ButtonLink
                            href="/work"
                            variant="outline"
                            size="3"
                            style={{
                                width: "fit-content",
                            }}
                        >
                            See more projects
                        </ButtonLink>
                    </Grid>
                </InnerSection>
            </MainGrid>
        </Theme>
    </Section>

    <!-- Closing -->
    <BottomCTA slot="bottom-cta" heading="What's the catch?">
        <Flex
            direction="column"
            gap="3"
            align="center"
            mt="-2"
            style={{ maxWidth: "60ch" }}
        >
            <Text size="3" as="p" align="center">
                I'm in the market for part-time and freelance work with teams
                who are stuck in the weeds. I'll be that someone who can edit,
                simplify, and bring focus. I will also consider full-time
                opportunities for the right match.
            </Text>
            <Text size="3" as="p" align="center" color="gray" mb="4">
                If you're thinking "I gotta speak to this guy" or you know a
                team who might be a perfect fit, I'd love to hear from you.
            </Text>
            <ButtonLink
                variant="surface"
                href={`mailto:${SITE_DATA.email}`}
                size="3"
            >
                {SITE_DATA.email}
            </ButtonLink>
            <Text size="2" color="gray" trim="both">
                or click here to <CopyEmailButton
                    client:visible
                    email={SITE_DATA.email}
                    variant="ghost"
                    style={{
                        margin: "unset",
                        padding: "unset",
                        height: "auto",
                        verticalAlign: "baseline",
                        cursor: "pointer",
                        textDecoration: "underline",
                    }}>copy my email</CopyEmailButton
                >
            </Text>
        </Flex>
    </BottomCTA>
</Layout>
