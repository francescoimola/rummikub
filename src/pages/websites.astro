---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading";
import { Image } from "astro:assets";
import { Text, Flex, Theme, Section, Box, Grid } from "@radix-ui/themes";
import { EXTERNAL_URLS, SEO } from "../constants";
import JsonLd from "../components/JsonLd.astro";
import {
    ArrowDownIcon,
    ArrowRightIcon,
    ArrowTopRightIcon,
} from "@radix-ui/react-icons";

// Portfolio images
import theloft from "../assets/portfolio/the_loft_homepage.png";
import tcaexperiment from "../assets/portfolio/tca_experiment.png";
import makemind from "../assets/portfolio/makemind_homepage.png";
import folksdirectory from "../assets/portfolio/folks-directory.png";
import tedxjourneys from "../assets/portfolio/tedx.png";
import { InnerSection } from "../components/InnerSection";
import { MainGrid } from "../components/MainGrid";
import { KeyServicePoints, KSP } from "../components/KeyServicePoints";
import { ButtonLink } from "../components/ButtonLink";

import { ProcessAccordion } from "../components/ProcessAccordion";
import { PricingTable } from "../components/PricingTable";
import { ContentCard } from "../components/ContentCard";
import FAQ from "../components/FAQ";
import tca from "../assets/tca_megamenu.png";
import { BottomCTA } from "../components/BottomCTA";
---

<Layout
    title={SEO.pages.websites.title}
    description={SEO.pages.websites.description}
    backgroundColor="var(--yellow-5)"
    roleFullWidth
    noMobileRole
>
    <Fragment slot="structured-data">
        <JsonLd
            data={{
                "@type": "Service",
                name: "Web Design & Development",
                description: SEO.pages.websites.description,
                provider: SEO.person,
                areaServed: {
                    "@type": "Place",
                    name: "Kent, United Kingdom",
                },
            }}
        />
    </Fragment>

    <!-- Hero Section -->
    <PageHeading slot="heading" className="page-heading">
        Unapologetically simple websites and copy
    </PageHeading>
    <Text slot="role" size="3" weight="medium" as="p">
        Taking on projects for Q1 2026
    </Text>
    <Flex slot="description" direction="column" gap="4">
        <Text size="3" as="p" wrap="pretty" highContrast>
            I help independent businesses and non-profits who are tired of
            apologising for their amateurish websites. I remove what shouldn't
            be there until you are left with something clearer, more confident,
            and worth showing off.
        </Text>

        <ButtonLink
            size="3"
            variant="soft"
            color="gray"
            href="#what-was-removed"
            style={{ alignSelf: "start" }}
        >
            Scroll to learn more <ArrowDownIcon />
        </ButtonLink>
    </Flex>

    <!-- Page Content -->
    <Theme
        slot="page-content"
        appearance="light"
        accentColor="yellow"
        grayColor="olive"
        radius="none"
        panelBackground="solid"
        asChild
    >
        <Section
            size="1"
            py="4"
            px={{ initial: "4", sm: "6" }}
            style={{
                overflow: "hidden",
            }}
        >
            <Flex
                id="portfolio-reel"
                gap="2"
                justify="center"
                align="center"
                wrap="nowrap"
                style={{
                    width: "max-content",
                    minWidth: "120%",
                }}
            >
                <Image
                    src={theloft}
                    alt="Homepage for The Loft"
                    class="portfolio-image"
                    loading="lazy"
                    quality={80}
                    format="webp"
                    widths={[400, 600, 800]}
                    sizes="(max-width: 768px) 40vw, 20vw"
                />
                <Image
                    src={folksdirectory}
                    alt="Folks Directory"
                    class="portfolio-image"
                    loading="lazy"
                    quality={80}
                    format="webp"
                    widths={[400, 600, 800]}
                    sizes="(max-width: 768px) 40vw, 20vw"
                />
                <Image
                    src={tcaexperiment}
                    alt="TC Baffles"
                    class="portfolio-image"
                    loading="lazy"
                    quality={80}
                    format="webp"
                    widths={[400, 600, 800]}
                    sizes="(max-width: 768px) 40vw, 20vw"
                />
                <Image
                    src={tedxjourneys}
                    alt="TEDx Journeys"
                    class="portfolio-image"
                    loading="lazy"
                    quality={80}
                    format="webp"
                    widths={[400, 600, 800]}
                    sizes="(max-width: 768px) 40vw, 20vw"
                    style={{ objectPosition: "top" }}
                />
                <Image
                    src={makemind}
                    alt="Make & Mind"
                    class="portfolio-image"
                    loading="lazy"
                    quality={80}
                    format="webp"
                    widths={[400, 600, 800]}
                    sizes="(max-width: 768px) 40vw, 20vw"
                />
            </Flex>
        </Section>
        <script>
            import { initParallax } from "../utils/parallax";

            // Run on load and after View Transitions
            initParallax();
            document.addEventListener("astro:page-load", initParallax);
        </script>

        <Box
            id="what-was-removed"
            style={{
                backgroundColor: "var(--gray-1)",
                overflow: "hidden",
            }}
        >
            <MainGrid pt="var(--space-11)">
                <InnerSection title="What I've taken out">
                    <KeyServicePoints>
                        <KSP heading="No hidden costs">
                            No way I'll surprise you with charges you weren't
                            expecting. Everything will be transparent from the
                            outset. The price I quote is the price you pay.
                        </KSP>
                        <KSP heading="No false promises">
                            I won't promise to "transform your brand" or "10x
                            your conversions." All I do is I craft sites that
                            load quickly, explain what you do, and won't
                            embarrass your brand.
                        </KSP>

                        <KSP heading="No dark patterns">
                            That means no privacy-aggressive or manipulative
                            design. Fewer pop-up banners and autoplaying videos.
                            You can trust your visitors will be respected.
                        </KSP>
                    </KeyServicePoints>
                </InnerSection>
                <InnerSection title="What you get">
                    <Grid columns={{ initial: "1", md: "2" }} gap="4">
                        <ContentCard
                            heading="A website even you can update"
                            backgroundColor="var(--yellow-3)"
                        >
                            That taste on your tongue? That's the freedom of
                            being able to change your own prices, hours, team
                            photos, blog posts, and testimonials... without
                            waiting on anyone.
                        </ContentCard>
                        <ContentCard
                            heading="Built for longevity"
                            backgroundColor="var(--yellow-3)"
                        >
                            You won't find me relying on fleeting design trends
                            or fiddly plugins that need constant maintenance.
                            The goal is building stuff that won't need replacing
                            any time soon.
                        </ContentCard>
                        <ContentCard
                            heading="Basic SEO, done proper"
                            backgroundColor="var(--yellow-3)"
                        >
                            Meta descriptions, core keywords, and image
                            compression are always included. The fundamentals
                            done right, and with room to build upon.
                        </ContentCard>
                        <ContentCard
                            heading="Accessibility taken seriously"
                            backgroundColor="var(--yellow-3)"
                        >
                            We'll always move with the user's needs in mind.
                            Perfection is a moving target of course, but the
                            baseline is always a responsive site that doesn't
                            unreasonably exclude anyone.
                        </ContentCard>
                        <figure style={{ gridColumn: "1 / -1" }}>
                            <Image
                                src={tca}
                                alt="concept for a new website for a local acoustics manufacturer"
                                loading="lazy"
                                style={{
                                    objectFit: "cover",
                                    width: "100%",
                                    height: "100%",
                                    backgroundColor: "var(--yellow-a3)",
                                }}
                            />
                            <Text asChild>
                                <figcaption>
                                    UI design for acoustics manufacturer The
                                    Collective, 2025
                                </figcaption>
                            </Text>
                        </figure>
                    </Grid>
                </InnerSection>
                <InnerSection title="The platforms">
                    <Flex direction="column" gap="6">
                        <Flex direction="column" gap="3">
                            <Text size="3" as="p" highContrast>
                                I work primarily in Framer and Webflow—with a few other tools for design,
                                analytics and email marketing. If you’re already
                                committed to a CMS or website-builder, I can
                                usually adapt as most platforms work on similar
                                principles.
                            </Text>
                        </Flex>
                        <ButtonLink
                            href="/about#tools"
                            variant="soft"
                            size="3"
                            color="gray"
                            highContrast
                            style={{ alignSelf: "flex-start" }}
                        >
                            More about my tools <ArrowRightIcon />
                        </ButtonLink>
                    </Flex>
                </InnerSection>
                <InnerSection title="The process">
                    <ProcessAccordion
                        client:idle
                        steps={[
                            {
                                number: 1,
                                title: "Discovery",
                                content: [
                                    "You tell me what's not working and what you wish your site could do. I ask a lot of questions, and then I start researching.",
                                    "Sometimes this phase is alls about competitor analysis. Some other times, it's talking to your customers. Or you might already have data and I just need to make sense of it. Either way, the goal is always to understand who's coming to your site and what they need to find, and then give it to them. Make people happy, surpise them even when it makes sense, and they'll return.",
                                ],
                            },
                            {
                                number: 2,
                                title: "Copy & Design",
                                linkHref: EXTERNAL_URLS.calendar.intro,
                                content: [
                                    "This is where the website takes shape, though how we get there depends on the project. We might start with wireframes, or with copy, or with a quick AI prototype that allows us react to an idea before we've invested weeks on it. ",
                                    "In terms of speed, the majority of projects will at least two rounds of revisions. Less for one page websites, which might click into place farily quickly. Either way, you get to see work early and give feedback, which I’ll refine until everything feels right.",
                                ],
                            },
                            {
                                number: 3,
                                title: "Production & Launch",
                                content: [
                                    "Once the direction is clear, I start building the website. This involves setting up page structure, making layouts adapt to different screen sizes, connecting the content management system (if we're using one), handling integrations, and thoroughly testing everything.",
                                    "Before launch, I'll show how to update the site yourself, and then it's yours. For ongoing projects, I stick around to keep things rolling.",
                                ],
                            },
                        ]}
                    />
                </InnerSection>
                <InnerSection title="Your other options">
                    <KeyServicePoints>
                        <KSP
                            heading="Doing it yourself"
                            grayWordCount={0}
                            multiParagraph
                        >
                            <Text wrap="pretty" as="p" color="gray">
                                You could ask AI or find a template, but
                                experience tells me DIY websites sit half-finished
                                for years. You'll likely never write all the
                                copy and you'll spend forever wrestling with
                                hosting. Leave the hard work to me and you'll
                                get a truly finished product.
                            </Text>
                        </KSP>
                        <KSP
                            heading="Shopping around"
                            grayWordCount={0}
                            multiParagraph
                        >
                            <Text wrap="pretty" as="p" color="gray">
                                I won’t be the cheapest, and I don't do 1-week
                                turnarounds. But you get results that you can
                                still afford (and enjoy!) to run a year later.
                                No storefront that stops working the minute you
                                take a day off. No blog if you don’t have time
                                to write. No designing around high-end stock
                                photos you can’t replicate.
                            </Text>
                        </KSP>
                    </KeyServicePoints>
                </InnerSection>
                <InnerSection title="Investment">
                    <PricingTable
                        introText={[
                            "How many hours have you spent trying to fix your broken website? How many more will you spend if nothing changes?",
                            "I can't tell you exactly what a functioning website is worth to your business. But I can tell you what it costs to stop fighting with the one you have:",
                        ]}
                        items={[
                            {
                                title: "Website + CMS",
                                asterisks: 1,
                                price: "£3,500",
                                description:
                                    "Up to 6 static pages + 2 CMS page templates. Ideal if you publish often and want your site regularly updated with fresh content (i.e. you're a commercial photographer or local museum)",
                            },
                            {
                                title: "Standard 3-6 page site",
                                asterisks: 1,
                                price: "£2,500",
                                description:
                                    "A site with no CMS (meaning no blog or content to update dynamically). Ideal for venues, hospitality businesses, and service professionals looking for a robust but simple solution.",
                            },
                            {
                                title: "One-pager",
                                asterisks: 1,
                                price: "£600",
                                description:
                                    "Up to 10 sections on a single page. Great for launches, events, cafes, and mini portfolios.",
                            },
                            {
                                title: "Design only",
                                asterisks: 2,
                                price: "£1895",
                                description:
                                    "I design and write the website, then hand it off ready-to-build to a developer, or to you.",
                            },
                        ]}
                        closingText="All prices are starting points and you'll get an exact quote before we begin. Worried about revisions? One round is always included and more available for a custom fee."
                        footnotes={[
                            "* Includes design, copywriting, and development.",
                            "** Includes design and copywriting.",
                        ]}
                    />
                </InnerSection>
                <InnerSection title="Add-ons">
                    <PricingTable
                        items={[
                            {
                                title: "SEO deep-dive",
                                price: "£395",
                                description:
                                    "Competitor analysis focused on improving your SEO, complete with an implementation plan. Involves sifting through 10+ years of data to find tactics and content ideas worth replicating.",
                            },
                            {
                                title: "E-commerce setup",
                                price: "£795",
                                description:
                                    "Gets you ready to handle high-volume orders. Includes notifications, item and shipping options, payment integration, and ad-hoc support.",
                            },
                            {
                                title: "Email marketing starter",
                                price: "£395",
                                description:
                                    "Mailing list setup and creation of 1 welcome campaign. Also gets you 1 custom template design and 1 email strategy session at no extra cost.",
                            },
                        ]}
                    />
                </InnerSection>
                <InnerSection title="Is this for you?">
                    <Grid columns={{ initial: "1", sm: "2" }} gap="4">
                        <ContentCard
                            heading="Absolutely yes, if"
                            backgroundColor="var(--yellow-a3)"
                            items={[
                                "Your current website is broken, slow, or plain embarrassing.",
                                "Value for money is your love language.",
                                "You'd rather work with one reliable person than manage a large team.",
                            ]}
                        />
                        <ContentCard
                            heading="Probably not, if"
                            backgroundColor="var(--orange-a3)"
                            items={[
                                "You need a complex web app with several custom features.",
                                'Promises about "transforming" stuff are your love language.',
                                "You don't believe it's worth the time.",
                            ]}
                        />
                    </Grid>
                </InnerSection>
                <InnerSection title="FAQs">
                    <Flex direction="column" gap="8">
                        <FAQ client:visible variant="websites" />
                    </Flex>
                </InnerSection>
            </MainGrid>
        </Box>
    </Theme>
    <BottomCTA
        client:visible
        slot="bottom-cta"
        heading="Made you curious? Let's talk"
        text="Book a free intro call to see if working together makes sense. There’s no pitch and no pressure."
        backgroundColor="var(--yellow-5)"
    >
        <Flex justify="center" align="start" gap="4" wrap="wrap">
            <ButtonLink
                href={EXTERNAL_URLS.calendar.intro}
                size={{ initial: "3", sm: "4" }}
                external
                highContrast
            >
                Book a free call <ArrowTopRightIcon />
            </ButtonLink>
            <ButtonLink
                href="/about#contact"
                size={{ initial: "3", sm: "4" }}
                variant="soft"
                color="gray">Contact directly</ButtonLink
            >
        </Flex>
    </BottomCTA>
</Layout>

<style>
    .portfolio-image {
        flex-shrink: 0;
        width: auto;
        height: clamp(11rem, 19vw, 21rem);
        background-color: var(--gray-a2);
        filter: drop-shadow(0.25rem 0.25rem 0.33rem var(--gray-a3));
        border: thin solid var(--gray-a3);
    }
</style>
