---
export const prerender = true;
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeading from "../../components/PageHeading";
import {
    Text,
    Flex,
    Box,
    Badge,
    AspectRatio,
    Theme,
    Heading,
    Separator,
    Card,
    Section,
    Grid,
} from "@radix-ui/themes";
import { Image } from "astro:assets";
import { MainGrid } from "../../components/MainGrid";
import { BottomCTA } from "../../components/BottomCTA";
import NewsletterForm from "../../components/NewsletterForm";
import { ArrowRightIcon } from "@radix-ui/react-icons";
import { ShareButtons } from "../../components/ShareButtons";
import { ButtonLink } from "../../components/ButtonLink";
import { InnerSection } from "../../components/InnerSection";
import BlogImage from "../../components/mdx/BlogImage.astro";
import { CommonMDXComponents } from "../../components/mdx/MDXComponents";
import { SEO } from "../../constants";
import JsonLd from "../../components/JsonLd.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => {
        // Strip extension from ID to create a clean slug
        const slug = post.data.slug || post.id.replace(/\.mdx$/, "");
        return {
            params: { slug },
            props: { post },
        };
    });
}

const { post } = Astro.props;
const { Content } = await render(post);

// 3. Define the component map for MDX
const components = {
    ...CommonMDXComponents,
    img: BlogImage,
};

// Date Formatting: "31 January, 2023"
const formattedDate = post.data.publishedDate.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
});

// Related Posts Logic
const allPosts = await getCollection("blog");
const relatedPosts = allPosts
    .filter((p) => p.id !== post.id)
    .map((p) => {
        const sharedTags = p.data.tags.filter((tag) =>
            post.data.tags.includes(tag),
        ).length;
        return { ...p, sharedTags };
    })
    .sort((a, b) => {
        if (b.sharedTags !== a.sharedTags) return b.sharedTags - a.sharedTags;
        return (
            new Date(b.data.publishedDate).valueOf() -
            new Date(a.data.publishedDate).valueOf()
        );
    })
    .slice(0, 2);

// SEO metadata from frontmatter
const seoTitle = `${post.data.title} | Francesco Imola`;
const seoDescription = post.data.excerpt;
const coverImageSrc =
    typeof post.data.coverImage === "string"
        ? post.data.coverImage
        : post.data.coverImage.src;
const isoDate = post.data.publishedDate.toISOString();
---

<Layout
    title={seoTitle}
    description={seoDescription}
    image={coverImageSrc}
    ogType="article"
    backgroundColor="var(--orange-5)"
    roleFullWidth
>
    <Fragment slot="structured-data">
        <JsonLd
            data={{
                "@type": "Article",
                headline: post.data.title,
                description: post.data.excerpt,
                image: new URL(
                    coverImageSrc,
                    Astro.site || Astro.url,
                ).toString(),
                datePublished: isoDate,
                dateModified: isoDate,
                author: SEO.person,
                publisher: {
                    "@type": "Person",
                    name: "Francesco Imola",
                    url: "https://francescoimola.com",
                },
                mainEntityOfPage: {
                    "@type": "WebPage",
                    "@id": Astro.url.toString(),
                },
                keywords: post.data.tags.join(", "),
            }}
        />
    </Fragment>

    <!-- Hero Section -->
    <PageHeading slot="heading"> {post.data.title} </PageHeading>
    <Grid slot="role" columns={{ initial: "1", sm: "3" }} width="100%">
        <Box gridColumn={{ initial: "1", sm: "2 / span 2" }}>
            <AspectRatio ratio={4 / 3}>
                <Image
                    src={post.data.coverImage}
                    alt={post.data.title}
                    loading="lazy"
                    widths={[400, 600, 900]}
                    sizes="(max-width: 640px) 100vw, 450px"
                    style={{
                        objectFit: "cover",
                        width: "100%",
                        height: "100%",
                        viewTransitionName: `post-image-${post.data.slug?.replace(/\//g, "-") || post.id.replace(/\.mdx$/, "")}`,
                    }}
                />
            </AspectRatio>
        </Box>
    </Grid>
    <Flex
        slot="description"
        direction="column"
        justify="between"
        height="100%"
        className="blog-excerpt-container"
    >
        {/* Top: Article excerpt */}

        <Text size="3" wrap="pretty" highContrast>
            {post.data.excerpt}
        </Text>

        {/* Bottom: Date and tags */}
        <Flex direction="column" gap="4">
            <Text size="2" color="gray">{formattedDate}</Text>
            <Flex gap="2">
                {
                    post.data.tags.map((tag) => (
                        <Badge
                            variant="outline"
                            color="gray"
                            size="2"
                            radius="none"
                        >
                            {tag}
                        </Badge>
                    ))
                }
            </Flex>
        </Flex>
    </Flex>
    <!-- --- Page Content --- -->
    <Section slot="page-content" asChild pt="0">
        <Theme
            appearance="light"
            accentColor="yellow"
            radius="none"
            grayColor="olive"
            panelBackground="solid"
            style={{ backgroundColor: "var(--gray-1)" }}
        >
            <!-- Main Content Grid -->
            <MainGrid className="blog-main-grid">
                <InnerSection
                    showCounter={false}
                    headerDisplay={{ initial: "none", sm: "block" }}
                    headerMargin={{ initial: "0", sm: "4", md: "0" }}
                >
                    <Flex
                        slot="header"
                        direction="column"
                        gap="3"
                        display={{ initial: "none", sm: "flex" }}
                    >
                        <Heading size="3" color="gray" weight="medium">
                            Share
                        </Heading>
                        <ShareButtons
                            title={post.data.title}
                            url={Astro.url.href}
                            client:load
                        />
                    </Flex>
                    <!-- Article Content (Right Column) -->
                    <Flex direction="column" gap="8">
                        <!-- Article Body -->
                        <Flex direction="column">
                            <Content components={components} />
                            <Separator size="4" my="4" />
                        </Flex>

                        <!-- Share Section (mobile only) -->
                        <Flex
                            direction="column"
                            gap="3"
                            display={{ initial: "flex", sm: "none" }}
                            mt="-4"
                        >
                            <Heading size="3" color="gray" weight="medium">
                                Share
                            </Heading>
                            <ShareButtons
                                title={post.data.title}
                                url={Astro.url.href}
                                client:load
                            />
                        </Flex>

                        <!-- You might also like Section -->
                        <Flex direction="column" gap="4">
                            <Flex
                                justify="between"
                                align="center"
                                wrap="wrap"
                                gap="4"
                            >
                                <Text size="3" weight="medium" highContrast>
                                    You might also like
                                </Text>
                                <ButtonLink
                                    href="/blog"
                                    size="2"
                                    variant="outline"
                                    color="gray"
                                >
                                    See all posts
                                </ButtonLink>
                            </Flex>

                            <Flex direction="column" gap="4">
                                {
                                    relatedPosts.map((relatedPost) => (
                                        <a
                                            href={`/blog/${relatedPost.data.slug || relatedPost.id.replace(/\.mdx$/, "")}`}
                                            style={{
                                                textDecoration: "none",
                                                color: "inherit",
                                            }}
                                        >
                                            <Card
                                                size="4"
                                                variant="ghost"
                                                style={{
                                                    margin: "unset",
                                                    backgroundColor:
                                                        "var(--gray-a3)",
                                                }}
                                            >
                                                <Flex
                                                    justify="between"
                                                    align="center"
                                                    gap="8"
                                                >
                                                    <Flex
                                                        direction="column"
                                                        gap="2"
                                                    >
                                                        <Text
                                                            size="3"
                                                            weight="medium"
                                                            highContrast
                                                        >
                                                            {
                                                                relatedPost.data
                                                                    .title
                                                            }
                                                        </Text>
                                                        <Text
                                                            size="3"
                                                            color="gray"
                                                        >
                                                            {
                                                                relatedPost.data
                                                                    .excerpt
                                                            }
                                                        </Text>
                                                    </Flex>
                                                    <ArrowRightIcon
                                                        width="18"
                                                        height="18"
                                                    />
                                                </Flex>
                                            </Card>
                                        </a>
                                    ))
                                }
                            </Flex>
                        </Flex>
                    </Flex>
                </InnerSection>
            </MainGrid>
        </Theme>
    </Section>
    <BottomCTA
        client:visible
        slot="bottom-cta"
        heading="Be the first to hear about new posts, projects & experiments"
        text="Very occasional emails but always worth reading. Your inbox is literally drooling at the idea."
        backgroundColor="var(--orange-4)"
    >
        <NewsletterForm client:visible textAlign="center" align="center" />
    </BottomCTA>
</Layout>

<style is:global>
    @media (max-width: 768px) {
        .blog-excerpt-container {
            margin-top: calc(var(--space-4) * -1);
        }

        .blog-hero-grid {
            padding-bottom: var(--space-12);
        }
    }
</style>
