---
export const prerender = true;
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeading from "../../components/PageHeading";
import {
    Text,
    Flex,
    Box,
    Badge,
    AspectRatio,
    Theme,
    Heading,
    Separator,
    Card,
    Section,
} from "@radix-ui/themes";
import { Image } from "astro:assets";
import { MainGrid } from "../../components/MainGrid";
import { BottomCTA } from "../../components/BottomCTA";
import NewsletterForm from "../../components/NewsletterForm";
import {
    Link2Icon,
    ArrowRightIcon,
    LinkedInLogoIcon,
    TwitterLogoIcon,
} from "@radix-ui/react-icons";
import { ButtonLink } from "../../components/ButtonLink";
import { InnerSection } from "../../components/InnerSection";
import { TfiFacebook } from "react-icons/tfi";
import BlogImage from "../../components/mdx/BlogImage.astro";
import { CommonMDXComponents } from "../../components/mdx/MDXComponents";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => {
        // Strip extension from ID to create a clean slug
        const slug = post.data.slug || post.id.replace(/\.mdx$/, "");
        return {
            params: { slug },
            props: { post },
        };
    });
}

const { post } = Astro.props;
const { Content } = await render(post);

// 3. Define the component map for MDX
const components = {
    ...CommonMDXComponents,
    img: BlogImage,
};

// Date Formatting: "31 January, 2023"
const formattedDate = post.data.publishedDate.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
});

// Related Posts Logic
const allPosts = await getCollection("blog");
const relatedPosts = allPosts
    .filter((p) => p.id !== post.id)
    .map((p) => {
        const sharedTags = p.data.tags.filter((tag) =>
            post.data.tags.includes(tag),
        ).length;
        return { ...p, sharedTags };
    })
    .sort((a, b) => {
        if (b.sharedTags !== a.sharedTags) return b.sharedTags - a.sharedTags;
        return (
            new Date(b.data.publishedDate).valueOf() -
            new Date(a.data.publishedDate).valueOf()
        );
    })
    .slice(0, 2);
---

<Layout backgroundColor="var(--orange-5)" roleFullWidth>
    <!-- Hero Section -->
    <PageHeading slot="heading"> {post.data.title} </PageHeading>
    <Flex slot="role" justify={{ initial: "start", sm: "end" }} width="100%">
        <Box width="340px">
            <AspectRatio ratio={4 / 3}>
                <Image
                    src={post.data.coverImage}
                    alt={post.data.title}
                    width={340}
                    height={255}
                    style={{
                        objectFit: "cover",
                        width: "100%",
                        height: "100%",
                        viewTransitionName: `post-image-${post.data.slug?.replace(/\//g, "-") || post.id.replace(/\.mdx$/, "")}`,
                    }}
                />
            </AspectRatio>
        </Box>
    </Flex>
    <Flex slot="description" direction="column" justify="between" height="100%">
        {/* Top: Article excerpt */}

        <Text size="3" wrap="pretty" highContrast>
            {post.data.excerpt}
        </Text>

        {/* Bottom: Date and tags */}
        <Flex direction="column" gap="4">
            <Text size="2" color="gray">{formattedDate}</Text>
            <Flex gap="2">
                {
                    post.data.tags.map((tag) => (
                        <Badge
                            variant="outline"
                            color="gray"
                            size="2"
                            radius="none"
                        >
                            {tag}
                        </Badge>
                    ))
                }
            </Flex>
        </Flex>
    </Flex>
    <!-- --- Page Content --- -->
    <Section slot="page-content" asChild>
        <Theme
            appearance="light"
            accentColor="yellow"
            radius="none"
            grayColor="olive"
            scaling="97%"
            panelBackground="solid"
            style={{ backgroundColor: "var(--gray-1)" }}
        >
            <!-- Main Content Grid -->
            <MainGrid>
                <InnerSection showCounter={false}>
                    <Flex slot="header" direction="column" gap="3">
                        <Heading size="3" color="gray" weight="medium">
                            Share
                        </Heading>
                        <Flex gap="3" align="center">
                            {/* LinkedIn - using LinkedInLogoIcon */}
                            <Box className="share-icon">
                                <LinkedInLogoIcon />
                            </Box>

                            {/* X/Twitter placeholder - using ChatBubbleIcon */}
                            <Box className="share-icon">
                                <TwitterLogoIcon />
                            </Box>

                            {/* Facebook placeholder - using PersonIcon */}
                            <Box className="share-icon">
                                <TfiFacebook />
                            </Box>

                            {/* Copy link - Link2Icon is appropriate */}
                            <Box className="share-icon">
                                <Link2Icon />
                            </Box>
                        </Flex>
                    </Flex>
                    <!-- Article Content (Right Column) -->
                    <Flex direction="column" gap="8">
                        <!-- Article Body -->
                        <Flex direction="column">
                            <Content components={components} />
                            <Separator size="4" my="4" />
                        </Flex>

                        <!-- You might also like Section -->
                        <Flex direction="column" gap="4">
                            <Flex
                                justify="between"
                                align="center"
                                wrap="wrap"
                                gap="4"
                            >
                                <Text size="3" weight="medium" highContrast>
                                    You might also like
                                </Text>
                                <ButtonLink
                                    href="/blog"
                                    size="2"
                                    variant="outline"
                                    color="gray"
                                >
                                    See all posts
                                </ButtonLink>
                            </Flex>

                            <Flex direction="column" gap="4">
                                {
                                    relatedPosts.map((relatedPost) => (
                                        <a
                                            href={`/blog/${relatedPost.data.slug || relatedPost.id.replace(/\.mdx$/, "")}`}
                                            style={{
                                                textDecoration: "none",
                                                color: "inherit",
                                            }}
                                        >
                                            <Card
                                                size="4"
                                                variant="ghost"
                                                style={{
                                                    margin: "unset",
                                                    backgroundColor:
                                                        "var(--gray-a3)",
                                                }}
                                            >
                                                <Flex
                                                    justify="between"
                                                    align="center"
                                                    gap="8"
                                                >
                                                    <Flex
                                                        direction="column"
                                                        gap="2"
                                                    >
                                                        <Text
                                                            size="3"
                                                            weight="medium"
                                                            highContrast
                                                        >
                                                            {
                                                                relatedPost.data
                                                                    .title
                                                            }
                                                        </Text>
                                                        <Text
                                                            size="3"
                                                            color="gray"
                                                        >
                                                            {
                                                                relatedPost.data
                                                                    .excerpt
                                                            }
                                                        </Text>
                                                    </Flex>
                                                    <ArrowRightIcon
                                                        width="18"
                                                        height="18"
                                                    />
                                                </Flex>
                                            </Card>
                                        </a>
                                    ))
                                }
                            </Flex>
                        </Flex>
                    </Flex>
                </InnerSection>
            </MainGrid>
        </Theme>
    </Section>
    <BottomCTA
        slot="bottom-cta"
        heading="Be the first to hear about new posts, projects & experiments"
        text="Sign up and get occasional emails about new projects, special offers, and event invites."
        backgroundColor="var(--orange-4)"
    >
        <NewsletterForm client:idle textAlign="center" align="center" />
    </BottomCTA>
</Layout>
