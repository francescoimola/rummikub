---
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading";
import { Text, Flex, Section, Theme, Link } from "@radix-ui/themes";
import BlogFilters from "../components/BlogFilters";
import BlogCard from "../components/BlogCard.astro";
import { InnerSection } from "../components/InnerSection";
import { MainGrid } from "../components/MainGrid";
import { getCollection } from "astro:content";
import { SEO } from "../constants";
import JsonLd from "../components/JsonLd.astro";

const allPosts = (await getCollection("blog")).sort(
    (a, b) =>
        new Date(b.data.publishedDate).valueOf() -
        new Date(a.data.publishedDate).valueOf(),
);
const recentPosts = allPosts.slice(0, 2);

const uniqueTags = [...new Set(allPosts.flatMap((p) => p.data.tags))];
---

<Layout
    title={SEO.pages.blog.title}
    description={SEO.pages.blog.description}
    backgroundColor="var(--brand-surface-dark-olive)"
    appearance="dark"
    roleFullWidth
    noMobileRole
>
    <Fragment slot="structured-data">
        <JsonLd
            data={{
                "@type": "Blog",
                name: "Francesco Imola's Blog",
                description: SEO.pages.blog.description,
                url: "https://francescoimola.com/blog",
                author: SEO.person,
            }}
        />
    </Fragment>

    <!-- Hero Section -->
    <PageHeading slot="heading"> Writing </PageHeading>
    <Flex slot="description" direction="column" gap="var(--space-10)">
        <Text size="3">
        Notes on marketing, design, and whether it's possible to make a living without following the playbook. Everything is told through my own experiences, failures, and successes. Some answers. Mostly questions. An extension of <Link href="https://notbadnotbad.substack.com">Not Bad</Link>.
        </Text>
        <BlogFilters tags={uniqueTags} client:load />
    </Flex>
    <Section slot="page-content" pt="0" asChild>
        <Theme
            appearance="light"
            accentColor="orange"
            radius="none"
            grayColor="olive"
            style={{ backgroundColor: "var(--gray-1)" }}
        >
            <MainGrid>
                <InnerSection title="Recent" showCounter={false}>
                    <Flex direction="column" gap="4" data-section="recent">
                        {
                            recentPosts.map((post) => {
                                const slug =
                                    post.data.slug ||
                                    post.id.replace(/\.mdx$/, "");
                                return (
                                    <div
                                        data-tags={post.data.tags
                                            .map((t) => t.toLowerCase())
                                            .join(",")}
                                    >
                                        <BlogCard
                                            title={post.data.title}
                                            excerpt={post.data.excerpt}
                                            tags={post.data.tags}
                                            coverImage={post.data.coverImage}
                                            href={`/blog/${slug}`}
                                        />
                                    </div>
                                );
                            })
                        }
                    </Flex>
                </InnerSection>
                <InnerSection
                    title="All"
                    showCounter={false}
                    sectionId="all-posts-section"
                >
                    <Flex direction="column" gap="4" data-section="all">
                        {
                            allPosts.map((post) => {
                                const slug =
                                    post.data.slug ||
                                    post.id.replace(/\.mdx$/, "");
                                return (
                                    <div
                                        data-tags={post.data.tags
                                            .map((t) => t.toLowerCase())
                                            .join(",")}
                                    >
                                        <BlogCard
                                            variant="compact"
                                            title={post.data.title}
                                            excerpt={post.data.excerpt}
                                            href={`/blog/${slug}`}
                                        />
                                    </div>
                                );
                            })
                        }
                    </Flex>
                </InnerSection>
            </MainGrid>
        </Theme>
    </Section>
</Layout>

<script>
    const allSection = document.getElementById("all-posts-section");
    const allTitleSpan = allSection?.querySelector<HTMLElement>(
        ".inner-section-title > span:last-child",
    );

    function updateAllTitle(filter: string) {
        if (!allTitleSpan) return;
        allTitleSpan.textContent = "";

        if (filter === "all") {
            allTitleSpan.textContent = "All";
        } else {
            let label;
            const acronyms: Record<string, string> = { "ui/ux": "UI/UX", "seo": "SEO" };
            label = filter.replace(/-/g, " ").replace(/\b\w+/g, (word) => acronyms[word.toLowerCase()] ?? (word.charAt(0).toUpperCase() + word.slice(1)));
            const btn = document.createElement("button");
            btn.className = "section-breadcrumb-all";
            btn.textContent = "All";
            allTitleSpan.appendChild(btn);
            allTitleSpan.appendChild(
                document.createTextNode("  " + "›" + "  " + label),
            );
        }
    }

    document.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>(
            ".section-breadcrumb-all",
        );
        if (!btn) return;
        document.dispatchEvent(
            new CustomEvent("blog-filter", { detail: "all" }),
        );
    });

    document.addEventListener("blog-filter", (event) => {
        const filter = (event as CustomEvent<string>).detail;
        const cards = document.querySelectorAll<HTMLElement>("[data-tags]");
        const recentSection = document
            .querySelector("[data-section='recent']")
            ?.closest("section");

        if (recentSection) {
            recentSection.style.display = filter === "all" ? "" : "none";
        }

        cards.forEach((card) => {
            if (filter === "all") {
                card.style.display = "";
                return;
            }
            const tags = card.dataset.tags?.split(",") ?? [];
            card.style.display = tags.includes(filter) ? "" : "none";
        });

        updateAllTitle(filter);
    });
</script>
