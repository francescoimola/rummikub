---
export const prerender = true;
/* --- Imports --- */
import ProjectCanvas from "../components/project/ProjectCanvas.astro";
import PageHeading from "../components/PageHeading";
import { ButtonLink } from "../components/ButtonLink";
import Layout from "../layouts/Layout.astro";
import { Text, Flex, Grid, Box, Link, Section } from "@radix-ui/themes";
import { ArrowRightIcon, ArrowTopRightIcon } from "@radix-ui/react-icons";
import { EXTERNAL_URLS, SEO } from "../constants";
import JsonLd from "../components/JsonLd.astro";
import MegaSeatingPlanLogo from "../components/icons/MegaSeatingPlanLogo.astro";
import Testimonial from "../components/Testimonial";
import { InnerSection } from "../components/InnerSection";
import { MainGrid } from "../components/MainGrid";
import SarahYLLogo from "../components/icons/SarahYLLogo.astro";
import BlueberryLogo from "../components/icons/BlueberryLogo.astro";
import { BottomCTA } from "../components/BottomCTA";
import { getFeaturedProjects } from "../utils/getFeaturedProjects";
import { KeyServicePoints, KSP } from "../components/KeyServicePoints";
import { ScrollReveal } from "../components/ScrollReveal";
const featuredProjects = await getFeaturedProjects();
const capabilities = [
  {
    heading: "Website design & development",
    text: "I make building great sites from messy briefs look easy. Bilingual in Figma, Webflow, Framer, HTML and CSS.",
    href: "/websites",
    buttonText: "Tell me more",
  },
  {
    heading: "Consulting",
    text: "Sense something isn't working, but don't know what exactly? A website consultation gives you what your therapist never could.",
    href: "/consultations",
    buttonText: "What's that?",
  },
  {
    heading: "Copywriting & content research",
    text: "As long as you're willing for me to taint your name with odd lexicon and inaccurate sentence structure, I'm in",
    href: "/about#contact",
    buttonText: "Share your brief",
  },
  {
    heading: "Email marketing",
    text: "Big big fan of welcome emails, automations, and hyper-personalized campaigns. Quality > quantity.",
    href: "/about#contact",
    buttonText: "Share your brief",
  },
];
---

<Layout
  title={SEO.pages.home.title}
  description={SEO.pages.home.description}
  backgroundColor="var(--yellow-3)"
  roleFullWidth
  noMobileRole
>
  <Fragment slot="structured-data">
    <JsonLd
      data={{
        "@type": "WebSite",
        name: "Francesco Imola",
        url: "https://francescoimola.com",
        description: SEO.pages.home.description,
      }}
    />
    <JsonLd data={SEO.person} />
  </Fragment>

  <!-- --- Hero --- -->

  <!-- Slot: Main Heading -->
  <PageHeading slot="heading" className="page-heading">
    Francesco Imola is a <Text as="span" color="orange">designer</Text> and
    <Text as="span" color="yellow">copywriter</Text> in Kent.
  </PageHeading>

  <!-- Slot: Job Role (Hidden on mobile) -->
  <Box slot="role" asChild>
    <Text size="3" as="p" weight="medium"
      >Open to new collaborations in 2026</Text
    >
  </Box>

  <!-- Slot: Introduction Text -->
  <Flex slot="description" direction="column" gap="3">
    <Text size="3" as="p" wrap="pretty" highContrast>
      I'm a designer, writer, and strategist. Folkestone is home. My obsession
      is peanut butter (on everything) and products so good they don't need any
      marketing.
    </Text>
    <Text size="3" as="p" wrap="pretty" highContrast>
      Unfortunately, not everyone is as lucky with what they're selling. So
      that's where I come in. I help brands to simplify and create space for big
      ideas. The hardest challenge is making it look easy.
    </Text>
    <ButtonLink
      href="/about#contact"
      variant="surface"
      color="gray"
      mt="3"
      size="3"
      style={{ alignSelf: "flex-start" }}
    >
      Say hello<ArrowRightIcon />
    </ButtonLink>
  </Flex>

  <!-- --- Page Content --- -->
  <Section
    slot="page-content"
    style={{ backgroundColor: "var(--gray-1)" }}
    pt="0"
  >
    <!-- Main Content Grid -->
    <MainGrid>
      <!-- --- Selected Work --- -->
      <InnerSection client:visible title="Selected work" animate>
        <Grid columns="1" gapY="8">
          {
            featuredProjects.map((project) => (
              <ProjectCanvas
                images={project.data.coverImages}
                alts={project.data.coverAlts}
                layout={project.data.coverLayout}
                title={project.data.title}
                skills={project.data.skills ?? []}
                href={
                  project.data.caseStudyStatus
                    ? undefined
                    : `/work/${project.data.slug}`
                }
                caseStudyStatus={project.data.caseStudyStatus}
              />
            ))
          }
          <ButtonLink
            href="/work"
            variant="soft"
            color="gray"
            size="3"
            style={{ width: "fit-content" }}
          >
            View all projects
          </ButtonLink>
        </Grid>
      </InnerSection>

      <InnerSection client:visible title="Where I can help" animate>
        <KeyServicePoints>
          {
            capabilities.map((capability) => (
              <KSP
                heading={capability.heading}
                href={capability.href}
                buttonText={capability.buttonText}
              >
                {capability.text}
              </KSP>
            ))
          }
        </KeyServicePoints>
      </InnerSection>

      <!-- --- Testimonials --- -->
      <InnerSection client:visible title="Happy Clients" animate>
        <Grid columns="1" gap="var(--space-10)">
          <Testimonial
            authorName="Rob Cowen"
            quote="Francesco has the rare talent of being able to embed himself in a niche that he previously knew nothing about, quickly understanding the intricacies and writing with the confidence of an insider"
            rating={5}
          >
            <aside slot="authorRole">
              Founder, <Link
                href="https://seatingplan.com"
                target="_blank"
                rel="noopener noreferrer">Mega Seating Plan</Link
              >
            </aside>
            <MegaSeatingPlanLogo slot="logo" />
          </Testimonial>
          <Testimonial
            authorName="Liv Pennington"
            quote="Francesco provided excellent tech support and reassurance for a web project. He's been very easy to work with."
            rating={5}
          >
            <aside slot="authorRole">
              <Link
                href="https://www.livpennington.com/"
                target="_blank"
                rel="noopener noreferrer">Artist & Arts Programmer</Link
              >
            </aside>
          </Testimonial>
          <MegaSeatingPlanLogo slot="logo" />

          <Testimonial
            authorName="Sarah Brown"
            quote="Great to work with. Helped me to rework my website copy to align with a new direction I wanted to take. He's quick and responsive"
            rating={5}
          >
            <aside slot="authorRole">
              <Link
                href="https://www.sarahyuklan.com/"
                target="_blank"
                rel="noopener noreferrer">Holistic Coach</Link
              >
            </aside>
            <SarahYLLogo slot="logo" />
          </Testimonial>
          <Testimonial
            authorName="Carly Anchal"
            quote="A dream collaborator. Organised and strategic, he asks the right questions, does his research, and presents fantastic options"
            rating={5}
          >
            <aside slot="authorRole">
              <Link
                href="https://www.linkedin.com/in/carly-anchal-nee-little-3a9b7112"
                target="_blank"
                rel="noopener noreferrer">PR & Marketing Manager</Link
              >
            </aside>
            <BlueberryLogo slot="logo" isWrapped />
          </Testimonial>
        </Grid>
      </InnerSection>
      <InnerSection client:visible title="The work I do best" animate>
        <Flex direction="column" gap="4">
          <Text size="3" as="p" wrap="pretty">
            I love working with good people working on things that matter to
            them. If you're in the weeds, I'll be in the weeds with you.
            Marketing's gone rogue, design team's stretched thin, nobody can
            agree on what the website should actually say, that kind of thing.
          </Text>
          <Text size="3" as="p" wrap="pretty">
            I'm open to part-time, freelance, or full-time for the right fit. If
            you need someone who can edit, simplify, and bring focus, you know
            where to find me.
          </Text>
        </Flex>
      </InnerSection>
    </MainGrid>
  </Section>
  <BottomCTA
    client:visible
    heading="Is this guy for real?"
    text="I could be, if you give me a chance. Whether it's a project or something bigger, let's chat first?"
    backgroundColor="var(--yellow-5)"
    slot="bottom-cta"
  >
    <Flex justify="center" align="start" gap="4" wrap="wrap">
      <ButtonLink
        href={EXTERNAL_URLS.calendar.intro}
        size={{ initial: "3", sm: "4" }}
        external
        highContrast
      >
        Book a free intro <ArrowTopRightIcon />
      </ButtonLink>
      <ButtonLink
        href="/about#contact"
        size={{ initial: "3", sm: "4" }}
        variant="soft"
        color="gray">Contact directly</ButtonLink
      >
    </Flex>
  </BottomCTA>
</Layout>
