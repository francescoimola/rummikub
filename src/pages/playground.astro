---
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading";
import PlaygroundProject from "../components/PlaygroundProject.astro";
import { Text, Flex, Section, Theme } from "@radix-ui/themes";
import { SEO, SITE_DATA } from "../constants";
import { MainGrid } from "../components/MainGrid";
import { InnerSection } from "../components/InnerSection";
import { ButtonLink } from "../components/ButtonLink";

// ── Project images ──
import oddAndWonderful from "../assets/playground/Odd-and-Wonderful.png";
import passingNotes1 from "../assets/playground/Translator-and-Editor-at-Passing-Notes-1.jpeg";
import passingNotes3 from "../assets/playground/Translator-and-Editor-at-Passing-Notes-3.jpeg";
import passingNotes4 from "../assets/playground/Translator-and-Editor-at-Passing-Notes-4.jpeg";
import timePoem from "../assets/playground/hzFHXi26Hpi4jFd_1760083993.jpeg";
import htfmah1 from "../assets/playground/How-to-feel-more-at-home-1.png";
import htfmah2 from "../assets/playground/How-to-feel-more-at-home-2.png";
import htfmah4 from "../assets/playground/How-to-feel-more-at-home-4.jpeg";
import eysiitp2 from "../assets/playground/Everything-You-See-Is-In-The-Past-2.png";
import eysiitp3 from "../assets/playground/Everything-You-See-Is-In-The-Past-3.png";
import eysiitp7 from "../assets/playground/Everything-You-See-Is-In-The-Past-7.png";
import eysiitp8 from "../assets/playground/Everything-You-See-Is-In-The-Past-8.png";
import eysiitp9 from "../assets/playground/Everything-You-See-Is-In-The-Past-9.png";
import eysiitp10 from "../assets/playground/Everything-You-See-Is-In-The-Past-10.png";
import eysiitp11 from "../assets/playground/Everything-You-See-Is-In-The-Past-11.png";
import eysiitp12 from "../assets/playground/Everything-You-See-Is-In-The-Past-12.png";
import eysiitp13 from "../assets/playground/Everything-You-See-Is-In-The-Past-13.png";
import fydmata1 from "../assets/playground/Feed-Your-Demons-and-Meet-the-Ally-1.png";
import fydmata2 from "../assets/playground/Feed-Your-Demons-and-Meet-the-Ally-2.png";
import fydmata3 from "../assets/playground/Feed-Your-Demons-and-Meet-the-Ally-3.png";
import threeYears2 from "../assets/playground/Three-Years-2.jpeg";
import threeYears3 from "../assets/playground/Three-Years-3.jpeg";
import threeYears4 from "../assets/playground/Three-Years-4.jpeg";
import newAlumni1 from "../assets/playground/New-Alumni-19-at-University-of-Greenwich-1.jpeg";
import newAlumni2 from "../assets/playground/New-Alumni-19-at-University-of-Greenwich-2.jpeg";
import newAlumni3 from "../assets/playground/New-Alumni-19-at-University-of-Greenwich-3.jpeg";
import newAlumni4 from "../assets/playground/New-Alumni-19-at-University-of-Greenwich-4.jpeg";
import exhibitionTitleBot from "../assets/playground/Exhibition-Title-Bot.png";
import inTheAisles1 from "../assets/playground/In-The-Aisles-1.png";
import inTheAisles2 from "../assets/playground/In-The-Aisles-2.png";
import concert1 from "../assets/playground/Concert-Photographer-at-Getintothis-1.jpeg";
import concert2 from "../assets/playground/Concert-Photographer-at-Getintothis-2.jpeg";
import concert3 from "../assets/playground/Concert-Photographer-at-Getintothis-3.jpeg";
import concert4 from "../assets/playground/Concert-Photographer-at-Getintothis-4.jpeg";
import concert5 from "../assets/playground/Concert-Photographer-at-Getintothis-5.jpeg";
import concert6 from "../assets/playground/Concert-Photographer-at-Getintothis-6.jpeg";
import musician from "../assets/playground/Musician.jpeg";

// ── Feature images ──
import readcv1 from "../assets/playground/Readcv-Features-1.png";
import readcv2 from "../assets/playground/Readcv-Features-2.png";
import readcv3 from "../assets/playground/Readcv-Features-3.png";
import readcv4 from "../assets/playground/Readcv-Features-4.png";
import htfmah3 from "../assets/playground/How-to-feel-more-at-home-3.jpeg";
import imageAsset from "../assets/playground/image-asset.jpeg";
---

<Layout
    title={SEO.pages.playground.title}
    description={SEO.pages.playground.description}
    backgroundColor="var(--brand-surface-dark-mustard)"
    appearance="dark"
    roleFullWidth
    noMobileRole
>
    <PageHeading slot="heading" className="page-heading">
        Experiments in art, connection, and technology
    </PageHeading>

    <Flex slot="description" direction="column" gap="4">
        <Text size="3" as="p" wrap="pretty">
            Because what you see elsewhere on this site is only a fraction of
            what I do, this is where you get to peek behind the scenes and at my
            creative practice.
        </Text>
        <Text size="3" as="p" wrap="pretty">
            I work with <Text weight="medium">words</Text> (poems, essays), <Text
                weight="medium">pixels</Text
            > (photography, code, net art) and <Text weight="medium"
                >the collective making of meaning</Text
            > (resources and gatherings). My practice changes frequently, and so likely
            will this page.
        </Text>
        <Text size="3" as="p" wrap="pretty">
            If you are interested in a collaboration of the creative kind, feel
            free to send me a message. I will never say no to sharing new ideas
            and meeting artists who do new and exciting things.
        </Text>
        <Flex gap="3" wrap="wrap" mt="2">
            <ButtonLink
                href={`mailto:${SITE_DATA.email}`}
                variant="outline"
                color="gray"
                size="2"
            >
                Get in touch
            </ButtonLink>
            <ButtonLink href="/work" variant="soft" color="gray" size="2">
                See my commercial portfolio
            </ButtonLink>
        </Flex>
    </Flex>

    <Section
        slot="page-content"
        pt="0"
        pb="0"
        style={{ backgroundColor: "var(--gray-1)" }}
    >
        <Theme
            appearance="light"
            accentColor="gray"
            radius="none"
            grayColor="olive"
            style={{ backgroundColor: "var(--gray-1)" }}
        >
            <MainGrid>
                <InnerSection
                    title="Projects"
                    sectionId="projects"
                    showCounter={false}
                >
                    <Flex
                        direction="column"
                        gap="9"
                        className="playground-projects"
                    >
                        <PlaygroundProject
                            title="Odd & Wonderful"
                            year="2024 – On hiatus"
                            link="https://oddandwonderful.substack.com/"
                            description="Personal essays in newsletter form for people who dare to live creative lives. We talk about the nature of being creative and living through trauma, and share cool stuff I find on the web."
                            images={[oddAndWonderful]}
                            alts={["Graphic design for Odd & Wonderful"]}
                        />

                        <PlaygroundProject
                            title="Translator and Editor at Passing Notes"
                            year="2023"
                            link="https://www.wannapassnotes.com/"
                            description="Edited and translated an interview between Nicoletta De Santoli & Domenico De Leo"
                            images={[
                                passingNotes1,
                                passingNotes3,
                                passingNotes4,
                            ]}
                            alts={[
                                "Passing Notes Zine",
                                "Extract from Nicoletta De Santoli's article in Passing Notes",
                                "Extract from Nicoletta De Santoli's article in Passing Notes",
                            ]}
                        />

                        <PlaygroundProject
                            title="Poem for a Timepiece"
                            year="2022"
                            link="http://timepoem.netlify.app"
                            description="A micro invitation to lose yourself in the unspoken."
                            images={[timePoem]}
                            alts={["Screenshot of one of the artwork's pages"]}
                        />

                        <PlaygroundProject
                            title="How to Feel More at Home"
                            year="2021"
                            link="https://francescoimola.github.io/htfmat/"
                            description="Fleeting, often contradictory thoughts about domestic space captured through photos, text, sound and interactive elements."
                            images={[htfmah1, htfmah2, htfmah4]}
                            alts={[
                                "Screenshot from interactive webpage with colourful shapes, images and text",
                                "Screenshot from interactive webpage with colourful shapes, images and text",
                                "Water overlayed by text reading 'our first home was our mother's womb'",
                            ]}
                        />

                        <PlaygroundProject
                            title="Everything You See Is In The Past"
                            year="2020"
                            link="https://drive.google.com/file/d/1AQ3RuogJDeLc54IJEakYAFARdY4AVVsu/view?usp=sharing"
                            description="An online exhibition and accompanying catalogue focusing on the ways in which emerging artists and curators have been affected by the increasingly dystopian internet culture of the last decade."
                            images={[
                                eysiitp2,
                                eysiitp3,
                                eysiitp7,
                                eysiitp8,
                                eysiitp9,
                                eysiitp10,
                                eysiitp11,
                                eysiitp12,
                                eysiitp13,
                            ]}
                            alts={[
                                "Multiple pages from a digital exhibition catalogue",
                                "Screenshot of the virtual exhibition 'Everything You See Is In The Past'",
                                "Page from the exhibition catalogue describing the work of Atom Chen Zidong",
                                "Page from the exhibition catalogue describing the work of Enes Alba",
                                "Page from the exhibition catalogue describing the work of Perce Jerrom",
                                "Q&A with Valentina Peri from the exhibition catalogue",
                                "Conversation with Ghislaine Boddington from the exhibition catalogue",
                                "The catalogue being set in Adobe InDesign",
                                "Screenshot of recorded conversation with Ghislaine Boddington",
                            ]}
                        />

                        <PlaygroundProject
                            title="Feed Your Demons and Meet the Ally"
                            year="2020"
                            description="A ZIP-compressed exhibition exploring fears, desires, and obstacles artists face in times of crisis and isolation. Featured works cross-referenced mythology, pop culture, the supernatural, and digital selfhood. Curated by Magda Żołędź (of ONE Project) and I, the exhibition opened with an online event featuring artwork walk-throughs, studio visits, and Q&As."
                            images={[fydmata1, fydmata2, fydmata3]}
                            alts={[
                                "Exhibition website, exhibition ZIP file, and screenshot from recorded talk",
                                "Exhibition essay",
                                "ZIP file with artworks",
                            ]}
                        />

                        <PlaygroundProject
                            title="On Inner Desires and Art-making in times of confinement"
                            year="2020"
                            description="Exhibition essay that accompanied the exhibition 'Feed Your Demons and Meet the Ally' where I reflect on how the time gifted us by the pandemic forced us to look for answers where none seem to exist."
                            alts={[]}
                        />

                        <PlaygroundProject
                            title="Three Years"
                            year="2019"
                            link="https://www.google.co.uk/books/edition/_/zxGKDwAAQBAJ?hl=en&kptab=overview"
                            description="Can re-framing social media content as a stream of consciousness tell the story of how it came to be? Three Years contains all my tweets from April 2016 to February 2019 – more than a thousand entries."
                            images={[threeYears2, threeYears3, threeYears4]}
                            alts={[
                                "Book cover, front",
                                "Book cover, back",
                                "Francesco reading the book live",
                            ]}
                        />

                        <PlaygroundProject
                            title="New Alumni '19 at University of Greenwich"
                            year="2019"
                            link="http://www.greenwichunigalleries.co.uk/new-alumni-2019/"
                            description="Co-curated with David Waterworth, this exhibition showcased the work of four University of Greenwich graduates: John Joseph Watters, Grace Diggens, Marilia Lezou and Rhiannon Ashley. Each of them working in an interdisciplinary field, doing their bit to make a positive impact on our environment and our community."
                            images={[
                                newAlumni1,
                                newAlumni2,
                                newAlumni3,
                                newAlumni4,
                            ]}
                            alts={[
                                "Artwork and exhibits from New Alumni '19",
                                "Artwork and architectural exhibits from New Alumni '19",
                                "Reading area besides the exhibition",
                                "Signage for New Alumni '19",
                            ]}
                        />

                        <PlaygroundProject
                            title="Exhibition Title Bot"
                            year="2018"
                            description="A semi-autonomous program that generated and tweeted 500+ exhibition titles for fictional art exhibitions, from the hilarious to the grotesque. It tweeted daily for two years between 2018 – 2021."
                            images={[exhibitionTitleBot]}
                            alts={[
                                "Selection of tweets with generated exhibition titles",
                            ]}
                        />

                        <PlaygroundProject
                            title="In The Aisles"
                            year="2018"
                            link="https://francescoimola.github.io/In-The-Aisles/"
                            description="Interactive web-work based on a story by Clemens Meyer. The site guides you through narrative extracts, accompanied by corrupted sketches, a forklift spun in space, and a soundtrack I composed."
                            images={[inTheAisles1, inTheAisles2]}
                            alts={[
                                "Homepage from net art project 'In The Aisles'",
                                "Page in interactive story with forklift render",
                            ]}
                        />

                        <PlaygroundProject
                            title="Concert Photographer at Getintothis"
                            year="2017"
                            link="https://www.getintothis.co.uk/search/Francesco+Imola"
                            description="Captured shots of concerts in Liverpool and the Merseyside area. My gig photography portfolio includes Nas, Idles, Real Estates, Tom Grennan, Nathan Fake, and Stealing Sheep."
                            images={[
                                concert1,
                                concert2,
                                concert3,
                                concert4,
                                concert5,
                                concert6,
                            ]}
                            alts={[
                                "Stealing Sheep bandmates dancing on stage with sparkly outfits",
                                "Member of Real Estate performing live",
                                "Nas singing on stage",
                                "Woman playing the ukulele",
                                "Real Estate performing live under dramatic stage lights",
                                "Bassist playing while lost in the music",
                            ]}
                        />

                        <PlaygroundProject
                            title="Musician"
                            year="2015"
                            link="https://francescoimola.bandcamp.com"
                            description="Made, released and performed music under my own name and the aliases Mountain King and Young Offices. Played in cover bands, dj'd and performed my own music at informal gigs in Italy and England."
                            images={[musician]}
                            alts={[
                                "Francesco performing in a church surrounded by a pensive audience",
                            ]}
                        />
                    </Flex>
                </InnerSection>

                <InnerSection
                    title="Features"
                    sectionId="features"
                    showCounter={false}
                >
                    <Flex
                        direction="column"
                        gap="9"
                        className="playground-projects"
                    >
                        <PlaygroundProject
                            title="Read.cv Features"
                            year="2023"
                            description="Read.cv was a portfolio and social networking platform for creatives. My projects got featured in their 'Features' section several times."
                            images={[readcv1, readcv2, readcv3, readcv4]}
                            alts={[
                                "Francesco's article featured on Read.cv's homepage",
                                "Francesco's article featured on Read.cv's homepage",
                                "Francesco's exhibition catalogue featured on Read.cv's homepage",
                                "Francesco's artwork featured on Read.cv's homepage",
                            ]}
                        />

                        <PlaygroundProject
                            title="How to Feel More at Home on Special Special"
                            year="2021"
                            link="https://specialspecial.com/blogs/journal/show-and-tell-25-br-how-to-feel-more-at-home-by-francesco-imola"
                            description="Feature on 'How to Feel More at Home' by Banyi Huang on Issue 25 of Show and Tell."
                            images={[htfmah3]}
                            alts={[
                                "Mobile screenshot of 'How to Feel More at Home' artwork",
                            ]}
                        />

                        <PlaygroundProject
                            title="Photography on Harbor Review"
                            year="2020"
                            link="https://www.harbor-review.com/issue-4-self"
                            description="Image 'Untitled(2)' was published in Issue 04: 'Self' of Harbor Review, an independent online space and publication for poetry and art."
                            images={[imageAsset]}
                            alts={[
                                "Still photo of a road, half the frame obscured by a light leak",
                            ]}
                        />
                    </Flex>
                </InnerSection>
            </MainGrid>
        </Theme>
    </Section>
</Layout>

<style is:global>
    /* ── Playground Project Layout ── */
    .playground-projects {
        grid-column: 1 / -1;
    }

    /* ── Carousel ── */
    .playground-carousel {
        all: unset;
        display: flex;
        gap: var(--space-3);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        padding-block: var(--space-2);

        /* Thin scrollbar */
        scrollbar-width: thin;
        scrollbar-color: var(--gray-a5) transparent;
    }

    .playground-carousel::-webkit-scrollbar {
        height: 6px;
    }

    .playground-carousel::-webkit-scrollbar-track {
        background: transparent;
    }

    .playground-carousel::-webkit-scrollbar-thumb {
        background: var(--gray-a5);
        border-radius: 3px;
    }

    /* Target the <picture> wrapper Astro generates */
    .playground-carousel picture {
        scroll-snap-align: start;
        flex: 0 0 auto;
        display: block;
    }

    /* Constrain the actual image */
    .playground-carousel img {
        max-height: 240px;
        width: auto;
        height: auto;
        object-fit: contain;
        border-radius: 2px;
        display: block;
    }

    /* ── Carousel wrapper & controls ── */
    .carousel-wrapper {
        position: relative;
    }

    .carousel-controls {
        display: flex;
        gap: var(--space-1);
        justify-content: flex-end;
        margin-block-start: var(--space-2);
    }

    .carousel-btn {
        all: unset;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        cursor: pointer;
        color: var(--gray-11);
        background-color: var(--gray-a3);
        border: thin solid var(--gray-a6);
        border-radius: 2px;
        transition:
            background-color 0.15s ease,
            color 0.15s ease;
    }

    .carousel-btn:hover {
        background-color: var(--gray-a5);
        color: var(--gray-12);
    }

    .carousel-btn:active {
        background-color: var(--gray-a7);
    }

    .carousel-btn:focus-visible {
        outline: 2px solid var(--accent-a8);
        outline-offset: 2px;
    }
</style>
