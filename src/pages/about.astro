---
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading";
import { ContactSHeader } from "../components/ContactSHeader";
import {
    Text,
    Flex,
    Link,
    DataList,
    Box,
    AspectRatio,
    Grid,
    Heading,
    Section,
} from "@radix-ui/themes";

import francescoImg from "../assets/francesco.jpg";
import SkipToNav from "../components/SkipToNav";
import { InnerSection } from "../components/InnerSection";
import { MainGrid } from "../components/MainGrid";
import FigmaIcon from "../components/icons/FigmaIcon.astro";

import { ToolCard } from "../components/ToolCard";
import WebflowIcon from "../components/icons/WebflowIcon.astro";
import BrevoIcon from "../components/icons/BrevoIcon.astro";
import FramerIcon from "../components/icons/FramerIcon.astro";         
import UmamiIcon from "../components/icons/UmamiIcon.astro";
import HTMLicon from "../components/icons/HTMLicon.astro";
import creativesForClimate from "../assets/sustainability-windows.png";
import FastForwardAnalogue from "../assets/Fast Forward to the Analogue - Poster Mockup.jpg";
import FAQ from "../components/FAQ";
import { ContactForm } from "../components/ContactForm";
import { TemplateDialog } from "../components/TemplateDialog";

import { ArrowDownIcon } from "@radix-ui/react-icons";
import { ButtonLink } from "../components/ButtonLink";
import { EXTERNAL_URLS, SITE_DATA, SEO } from "../constants";
import JsonLd from "../components/JsonLd.astro";
import { Picture } from "astro:assets";
---

<Layout
    title={SEO.pages.about.title}
    description={SEO.pages.about.description}
    backgroundColor="var(--orange-5)"
    roleFullWidth
    noMobileRole
>
    <Fragment slot="structured-data">
        <JsonLd data={SEO.person} />
    </Fragment>

    <PageHeading slot="heading" className="page-heading">
        A web and content designer. A creative with a conscience. A friend.
    </PageHeading>
    <SkipToNav
        anchors={[
            { href: "#intro", label: "About" },
            { href: "#tools", label: "Tools" },
            { href: "#sustainability", label: "Sustainability" },
            { href: "#recognitions", label: "Recognitions" },
            { href: "#faqs", label: "FAQs" },
            { href: "#contact", label: "Contact details" },
        ]}
        slot="role"
        display={{ initial: "none", sm: "flex" }}
    />
    <Flex
        slot="description"
        className="about-grid"
        align="start"
        gap="5"
        style={{ containerType: "inline-size" }}
    >
        <Box flexGrow="1" flexShrink="2" className="about-image">
            <AspectRatio ratio={1}>
                <Picture
                    src={francescoImg}
                    alt="Francesco Imola"
                    formats={["avif", "webp"]}
                    loading="eager"
                    style={{
                        objectFit: "cover",
                        width: "100%",
                        height: "100%",
                    }}
                />
            </AspectRatio>
        </Box>
        <Flex flexGrow="1" direction="row" justify="between">
            <DataList.Root orientation="vertical" size="2">
                <DataList.Item>
                    <DataList.Label>Email</DataList.Label>
                    <DataList.Value>
                        <Link
                            href={`mailto:${SITE_DATA.email}`}
                            highContrast
                            wrap="nowrap"
                        >
                            {SITE_DATA.email}
                        </Link>
                    </DataList.Value>
                </DataList.Item>
                <DataList.Item>
                    <DataList.Label>Location</DataList.Label>
                    <DataList.Value>
                        <Text wrap="balance">{SITE_DATA.location}</Text>
                    </DataList.Value>
                </DataList.Item>
                <DataList.Item>
                    <DataList.Label>Status</DataList.Label>
                    <DataList.Value>
                        <Flex align="center" gap="2">
                            <Text color="grass">
                                <svg
                                    width="12"
                                    height="12"
                                    viewBox="0 0 10 10"
                                    fill="currentColor"
                                    xmlns="http://www.w3.org/2000/svg"
                                    aria-hidden="true"
                                >
                                    <circle cx="5" cy="5" r="5"></circle>
                                </svg>
                            </Text>
                            <Text wrap="balance"
                                >Available for collaborations in 2026</Text
                            >
                        </Flex>
                    </DataList.Value>
                </DataList.Item>
            </DataList.Root>
        </Flex>
    </Flex>
    <Section
        slot="page-content"
        pt="0"
        style={{ backgroundColor: "var(--gray-1)" }}
    >
        <MainGrid>
            <InnerSection title="About" sectionId="intro">
                <Flex direction="column" gap="4">
                    <Text size="3" wrap="pretty">
                        Hi, I'm Francesco, a designer and trust-based marketer from Italy, now based in Folkestone, on the Kent coast. My strengths lie
                        in UX, copywriting, brand messaging, and the often unglamorous work of being
                        reliable.
                    </Text>
                    <Text size="3" wrap="pretty">
                        Throughout my career, I have seen innumerable businesses
                        squander staggering sums of money on sloppy marketing,
                        graphic design and websites that inevitably confuse
                        people and ruin their brand's reputation. Thankfully, I
                        soon learned how to stop that from happening.
                    </Text>
                    <Text size="3" wrap="pretty">
                        Before landing in this sector, I spent six years working
                        in cultural institutions and at a film and TV talent
                        agency. Different sectors, but broadly the same job:
                        making complex realities a little less complex and
                        drawing audiences closer to worthwhile ideas, services
                        and creative talent. I graduated with a degree in
                        Digital Arts from the University of Greenwich, and that
                        is where much of this all began.
                    </Text>
                    <figure style={{ marginBlock: "var(--space-5)" }}>
                        <Picture
                            src={FastForwardAnalogue}
                            alt="Mockup of two computer windows, one shows a cliff, the other the Creatives for Climate logo"
                            formats={["avif", "webp"]}
                            loading="lazy"
                            style={{
                                width: "100%",
                                height: "auto",
                                maxWidth: "100%",
                            }}
                        />
                        <Text wrap="pretty" asChild>
                            <figcaption>
                                Poster design for Fast Forward to the Analogue,
                                University of Greenwich Galleries, 2019
                            </figcaption>
                        </Text>
                    </figure>
                </Flex>
            </InnerSection>
            <InnerSection
                title="What makes the difference"
                sectionId="difference"
            >
                <Flex direction="column" gap="4">
                    <Text size="3" wrap="pretty">
                        If you’re a business or an independent organisation
                        looking for help with your website or with the strategy,
                        content and integrations that surround it, I’ll bend
                        over backwards to lighten your workload and set your
                        business on the path to success.
                    </Text>
                    <Text size="3" wrap="pretty"
                        >What sets me apart is my hands-on approach: I
                        personally handle virtually every aspect of every
                        project, from strategy to copywriting, design and
                        development. This means fewer variables, lower overheads
                        for you, and a more cohesive end product. I also keep
                        sustainability and longevity top of mind, both in the
                        final result and in how I achieve it.
                    </Text>
                </Flex>
            </InnerSection>
            <InnerSection title="Tools" sectionId="tools">
                <Flex direction="column" gap="7">
                    <Text size="3" as="p" wrap="pretty">
                        The software I tend to reach for is reliable, easy to
                        hand over, and privacy-conscious where we're dealing
                        with people's data. I also understand the code that
                        powers the web, and sometimes that's the better answer.
                    </Text>
                    <FAQ title="Peek at my toolbox" client:visible>
                        <Flex direction="column" gap="7">
                            <Grid gap="4" columns={{ initial: "1", md: "2" }}>
                                <ToolCard
                                    title="Figma"
                                    description="A tool for designing and prototyping, allowing feedback and rapid iteration"
                                >
                                    <FigmaIcon />
                                </ToolCard>
                                <ToolCard
                                    title="Plain code"
                                    description="I can build simple 1-3 page sites with unbreakable HTML, CSS and JavaScript."
                                >
                                    <HTMLicon />
                                </ToolCard>
                                <ToolCard
                                    title="Framer"
                                    description="An all-in-one website platform for businesses who need to move fast"
                                >
                                    <FramerIcon />
                                </ToolCard>
                                <ToolCard
                                    title="Webflow"
                                    description="The ideal CMS for complex websites or when accessibility is a key concern"
                                >
                                    <WebflowIcon />
                                </ToolCard>
                                
                                <ToolCard
                                    title="Umami"
                                    description="For privacy-focused, GDPR-compliant analytics. Zero annoying cookies"
                                >
                                    <UmamiIcon />
                                </ToolCard>
                                <ToolCard
                                    title="Brevo"
                                    description="Easy to use email and CRM tool that lets you pay for what you need"
                                >
                                    <BrevoIcon />
                                </ToolCard>
                            </Grid>
                            <Box
                                p="6"
                                style={{
                                    backgroundColor: "var(--yellow-2)",
                                    border: "thin solid var(--yellow-a6)",
                                }}
                            >
                                <Text size="3" as="p" wrap="pretty">
                                    <Text weight="medium">
                                        Already committed elsewhere?
                                    </Text>
                                    I can adapt to other solutions based on your preferences.
                                    I've previously tested Mailchimp, Astro, Loops,
                                    Ahrefs, and Luma, among others.
                                </Text>
                            </Box>
                        </Flex>
                    </FAQ>
                </Flex>
            </InnerSection>
            <InnerSection title="Sustainability" sectionId="sustainability">
                <Flex direction="column" gap="6">
                    <Picture
                        src={creativesForClimate}
                        alt="Mockup of two computer windows, one shows a cliff, the other the Creatives for Climate logo"
                        formats={["avif", "webp"]}
                        loading="lazy"
                        style={{
                            width: "100%",
                            height: "auto",
                            maxWidth: "100%",
                        }}
                    />
                    <Flex direction="column" gap="4">
                        <Text size="3" as="p" wrap="pretty">
                            If there is one constant in my journey, it has been
                            the desire to work for worthy causes, and the only
                            way to fulfil this desire is to rethink what matters
                            most. It took around 4.6 billion years for a cosmic
                            swirl of gas and dust to become a planet suitable
                            for birds and flowers and children. The last thing I
                            want to do is devote my time to furthering its
                            destruction. As such, in 2025, I joined Creatives
                            for Climate, a global network of creative
                            professionals who are putting their skills to work
                            in the fight for the climate. I'm also a member of
                            Good Folk, a collective that offers pro-bono support
                            to charities with a lot on their plate.
                        </Text>
                        <Text size="3" as="p" wrap="pretty">
                            Although my practice is far from perfect, I see
                            every project as an opportunity to shape the change
                            I wish to see. For the record, I will not work with
                            clients in the fossil fuel sector, or those directly
                            associated with this industry.
                        </Text>
                    </Flex>
                </Flex>
            </InnerSection>
            <InnerSection title="Recognitions" sectionId="recognitions">
                <Flex direction="column" gap="5">
                    <Text size="2" weight="medium">2026</Text>
                    <DataList.Root
                        size="3"
                        orientation={{ initial: "vertical", sm: "horizontal" }}
                    >
                        <DataList.Item>
                            <DataList.Label>CSS Design Awards</DataList.Label>
                            <DataList.Value
                                >Special Kudos | francescoimola.com</DataList.Value
                            >
                        </DataList.Item>
                        <DataList.Item>
                            <DataList.Label>CSS Design Awards</DataList.Label>
                            <DataList.Value
                                >Public Awards &middot; Best UI, UX and
                                Innovation | francescoimola.com</DataList.Value
                            >
                        </DataList.Item>
                    </DataList.Root>
                    <Text size="2" weight="medium">2023</Text>
                    <DataList.Root
                        size="3"
                        orientation={{ initial: "vertical", sm: "horizontal" }}
                    >
                        <DataList.Item>
                            <DataList.Label>Read CV Feature</DataList.Label>
                            <DataList.Value
                                >Breaking free from the algorithm | Substack
                                post</DataList.Value
                            >
                        </DataList.Item>
                        <DataList.Item>
                            <DataList.Label>Read CV Feature</DataList.Label>
                            <DataList.Value
                                >I fell into a sustainable design rabbit hole |
                                Substack post</DataList.Value
                            >
                        </DataList.Item>
                        <DataList.Item>
                            <DataList.Label>Read CV Feature</DataList.Label>
                            <DataList.Value
                                >Everything you see is in the past | Exhibition
                                Catalogue</DataList.Value
                            >
                        </DataList.Item>
                        <DataList.Item>
                            <DataList.Label>Read CV Feature</DataList.Label>
                            <DataList.Value
                                >How to Feel More at Home | artwork &middot; net
                                art</DataList.Value
                            >
                        </DataList.Item>
                    </DataList.Root>
                    <Text size="2" weight="medium">2021</Text>
                    <DataList.Root
                        size="3"
                        orientation={{ initial: "vertical", sm: "horizontal" }}
                    >
                        <DataList.Item>
                            <DataList.Label>Special Special</DataList.Label>
                            <DataList.Value
                                >How to Feel More at Home | artwork &middot; net
                                art</DataList.Value
                            >
                        </DataList.Item>
                        <DataList.Item>
                            <DataList.Label
                                >Harbor Review &middot; Issue 04</DataList.Label
                            >
                            <DataList.Value
                                >'Untitled(2)' | artwork &middot; photography</DataList.Value
                            >
                        </DataList.Item>
                    </DataList.Root>
                </Flex>
            </InnerSection>
            <InnerSection title="Frequently asked questions" sectionId="faq">
                <Flex direction="column" gap="8">
                    <FAQ variant="about" client:visible />
                    <Flex direction="column" gap="3">
                        <Heading size="3" as="h3" weight="medium"
                            >Have a better question?</Heading
                        >
                        <Text size="3" as="p" mb="2">
                            Send me a message and we'll talk through everything.
                        </Text>
                        <ButtonLink
                            href="#contact"
                            size="3"
                            color="gray"
                            variant="soft"
                            style={{ alignSelf: "flex-start" }}
                        >
                            Scroll down to get in touch <ArrowDownIcon />
                        </ButtonLink>
                    </Flex>
                </Flex>
            </InnerSection>
        </MainGrid>
    </Section>
    <Section
        slot="bottom-cta"
        style={{
            backgroundColor: "var(--orange-5)",
            margin: "unset",
            padding: "unset",
            paddingBottom: "var(--space-10)",
        }}
    >
        <MainGrid>
            <InnerSection
                title="Knock on my door"
                sectionId="contact"
                showCounter={false}
            >
                <ContactSHeader slot="header" />
                <Flex direction="column" gap="6">
                    <Flex direction="column" gap="1">
                        <Heading size="3" as="h3" weight="medium"
                            >Send me a good 'ol email</Heading
                        >
                        <Link
                            href={`mailto:${SITE_DATA.email}`}
                            size="3"
                            highContrast
                            underline="always"
                        >
                            {SITE_DATA.email}
                        </Link>
                    </Flex>
                    <Flex direction="column" gap="1">
                        <Heading size="3" as="h3" weight="medium"
                            >Put a face to the name</Heading
                        >
                        <Link
                            href={`${EXTERNAL_URLS.calendar.intro}?description=direct-contact`}
                            target="_blank"
                            rel="noopener noreferrer"
                            size="3"
                            highContrast
                            underline="always"
                        >
                            Book a free introduction
                        </Link>
                    </Flex>
                    <Flex direction="column" gap="1">
                        <Heading size="3" as="h3" weight="medium"
                            >Prefer a form?</Heading
                        >
                        <Text size="3" highContrast> Fill the one below </Text>
                    </Flex>
                    <Flex direction="column" gap="1">
                        <Heading size="3" as="h3" weight="medium"
                            >Not sure what to say?</Heading
                        >
                        <TemplateDialog client:visible />
                    </Flex>
                    <ContactForm client:visible />
                </Flex>
            </InnerSection>
        </MainGrid>
    </Section>
</Layout>

<style>
    .about-grid {
        display: flex;
        flex-direction: row;

        @container (max-width: 520px) {
            flex-direction: column;

            .about-image {
                flex-basis: 100%;
            }
        }
    }

    .about-image {
        flex-basis: clamp(25%, 33%, 50%);
    }
</style>
