---
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading";
import { ContactSHeader } from "../components/ContactSHeader";
import {
    Text,
    Flex,
    Link,
    DataList,
    Box,
    AspectRatio,
    Grid,
    Heading,
    Section,
} from "@radix-ui/themes";

import francescoImg from "../assets/francesco.jpg";
import SkipToNav from "../components/SkipToNav";
import { InnerSection } from "../components/InnerSection";
import { MainGrid } from "../components/MainGrid";
import FigmaIcon from "../components/icons/FigmaIcon.astro";
import { ToolCard } from "../components/ToolCard";
import WebflowIcon from "../components/icons/WebflowIcon.astro";
import BrevoIcon from "../components/icons/BrevoIcon.astro";
import FramerIcon from "../components/icons/FramerIcon.astro";
import ShopifyIcon from "../components/icons/ShopifyIcon.astro";
import UmamiIcon from "../components/icons/UmamiIcon.astro";
import creativesForClimate from "../assets/sustainability-windows.png";
import FastForwardAnalogue from "../assets/Fast Forward to the Analogue - Poster Mockup.jpg";
import FAQ from "../components/FAQ";
import { ContactForm } from "../components/ContactForm";
import { TemplateDialog } from "../components/TemplateDialog";
import { ContentCard } from "../components/ContentCard";
import { AccordionSection } from "../components/AccordionSection";
import { ArrowDownIcon } from "@radix-ui/react-icons";
import { ButtonLink } from "../components/ButtonLink";
import { EXTERNAL_URLS, SITE_DATA, SEO } from "../constants";
import JsonLd from "../components/JsonLd.astro";
import { Picture } from "astro:assets";
---

<Layout
    title={SEO.pages.about.title}
    description={SEO.pages.about.description}
    backgroundColor="var(--orange-5)"
    roleFullWidth
>
    <Fragment slot="structured-data">
        <JsonLd data={SEO.person} />
    </Fragment>

    <PageHeading slot="heading" className="page-heading">
        A designer who writes, a writer who designs, and a strategist who does
        both
    </PageHeading>
    <SkipToNav
        anchors={[
            { href: "#intro", label: "About" },
            { href: "#tools", label: "Tools" },
            { href: "#sustainability", label: "Sustainability" },
            { href: "#recognitions", label: "Recognitions" },
            { href: "#faqs", label: "FAQs" },
            { href: "#contact", label: "Contact details" },
        ]}
        slot="role"
        display={{ initial: "none", sm: "flex" }}
    />
    <Flex
        slot="description"
        className="about-grid"
        align="start"
        gap="5"
        style={{ containerType: "inline-size" }}
    >
        <Box flexGrow="1" flexShrink="2" className="about-image">
            <AspectRatio ratio={1}>
                <Picture
                    src={francescoImg}
                    alt="Francesco Imola"
                    formats={["avif", "webp"]}
                    loading="eager"
                    style={{
                        objectFit: "cover",
                        width: "100%",
                        height: "100%",
                    }}
                />
            </AspectRatio>
        </Box>
        <Flex flexGrow="1" direction="row" justify="between">
            <DataList.Root orientation="vertical" size="2">
                <DataList.Item>
                    <DataList.Label>Email</DataList.Label>
                    <DataList.Value>
                        <Link
                            href={`mailto:${SITE_DATA.email}`}
                            highContrast
                            wrap="nowrap"
                        >
                            {SITE_DATA.email}
                        </Link>
                    </DataList.Value>
                </DataList.Item>
                <DataList.Item>
                    <DataList.Label>Location</DataList.Label>
                    <DataList.Value>
                        <Text wrap="balance">{SITE_DATA.location}</Text>
                    </DataList.Value>
                </DataList.Item>
                <DataList.Item>
                    <DataList.Label>Status</DataList.Label>
                    <DataList.Value>
                        <Flex align="center" gap="2">
                            <Text color="grass">
                                <svg
                                    width="12"
                                    height="12"
                                    viewBox="0 0 10 10"
                                    fill="currentColor"
                                    xmlns="http://www.w3.org/2000/svg"
                                    aria-hidden="true"
                                >
                                    <circle cx="5" cy="5" r="5"></circle>
                                </svg>
                            </Text>
                            <Text wrap="balance"
                                >Available for collaborations in 2026</Text
                            >
                        </Flex>
                    </DataList.Value>
                </DataList.Item>
            </DataList.Root>
        </Flex>
    </Flex>
    <Section
        slot="page-content"
        pt="0"
        style={{ backgroundColor: "var(--gray-1)" }}
    >
        <MainGrid>
            <InnerSection title="About" sectionId="intro">
                <Flex direction="column" gap="4">
                    <Text size="3" wrap="pretty">
                        Hi, I'm Francesco, a UI/UX designer and trust-based
                        marketer based in Folkestone, on the Kentish coast. I
                        spent half of my career watching businesses of all sizes
                        waste unbelievable amounts of money on sloppy marketing
                        and websites that inevitably confuse people and sh*t on
                        their reputation. Until I learned how to stop that from
                        happening.
                    </Text>
                    <Text size="3" wrap="pretty">
                        My current focus is helping independent businesses and
                        orgs with their websites + the strategy, copy, and
                        integrations that makes them useful. I handle the whole
                        thing, from strategy to copy, design, and build. This
                        means fewer moving parts and less overhead.
                    </Text>
                    <Text size="3" wrap="pretty">
                        Before this, I spent six years in galleries,
                        institutions, and an agency that represented freelance
                        film talent. Different industries but same job,
                        essentially: making complex things a little less complex
                        and helping good work find its audience. I'm a Digital
                        Arts graduate from the University of Greenwich, which is
                        where a lot of this started.
                    </Text>
                    <figure style={{ marginBlock: "var(--space-5)" }}>
                        <Picture
                            src={FastForwardAnalogue}
                            alt="Mockup of two computer windows, one shows a cliff, the other the Creatives for Climate logo"
                            formats={["avif", "webp"]}
                            loading="lazy"
                            style={{
                                width: "100%",
                                height: "auto",
                                maxWidth: "100%",
                            }}
                        />
                        <Text wrap="pretty" asChild>
                            <figcaption>
                                Poster design for Fast Forward to the Analogue,
                                University of Greenwich Galleries, 2019
                            </figcaption>
                        </Text>
                    </figure>
                </Flex>
            </InnerSection>
            <InnerSection title="Tools" sectionId="tools">
                <Flex direction="column" gap="7">
                    <Text size="3" as="p" wrap="pretty">
                        The software I usually reach for is reliable, easy to
                        hand over, and privacy-conscious where we're dealing
                        with people's data. I also understand the code that
                        powers the web, and sometimes that's the better answer.
                    </Text>
                    <AccordionSection title="Peek at my toolbox" client:visible>
                        <Flex direction="column" gap="7">
                            <Grid gap="4" columns={{ initial: "1", md: "2" }}>
                                <ToolCard
                                    title="Figma"
                                    description="A tool for designing and prototyping, allowing feedback and rapid iteration"
                                >
                                    <FigmaIcon />
                                </ToolCard>
                                <ToolCard
                                    title="Webflow"
                                    description="The ideal CMS for complex websites or when accessibility is a key concern"
                                >
                                    <WebflowIcon />
                                </ToolCard>
                                <ToolCard
                                    title="Framer"
                                    description="An all-in-one website platform for businesses who need to move fast"
                                >
                                    <FramerIcon />
                                </ToolCard>
                                <ToolCard
                                    title="Shopify"
                                    description="Everything-managed e-commerce CMS with every feature and more"
                                >
                                    <ShopifyIcon />
                                </ToolCard>
                                <ToolCard
                                    title="Umami"
                                    description="For privacy-focused, GDPR-compliant analytics. Zero annoying cookies"
                                >
                                    <UmamiIcon />
                                </ToolCard>
                                <ToolCard
                                    title="Brevo"
                                    description="Easy to use email and CRM tool that lets you pay for what you need"
                                >
                                    <BrevoIcon />
                                </ToolCard>
                            </Grid>
                            <Box
                                p="6"
                                style={{
                                    backgroundColor: "var(--yellow-2)",
                                    border: "thin solid var(--yellow-a6)",
                                }}
                            >
                                <Text size="3" as="p" wrap="pretty">
                                    <Text weight="medium">
                                        Already committed elsewhere?
                                    </Text>
                                    I can adapt to other solutions based on your preferences.
                                    I've previously tested Wordpress, Mailchimp, Loops,
                                    Ahrefs, and Luma, among others.
                                </Text>
                            </Box>
                        </Flex>
                    </AccordionSection>
                </Flex>
            </InnerSection>
            <InnerSection title="Sustainability" sectionId="sustainability">
                <Flex direction="column" gap="6">
                    <Picture
                        src={creativesForClimate}
                        alt="Mockup of two computer windows, one shows a cliff, the other the Creatives for Climate logo"
                        formats={["avif", "webp"]}
                        loading="lazy"
                        style={{
                            width: "100%",
                            height: "auto",
                            maxWidth: "100%",
                        }}
                    />
                    <Flex direction="column" gap="4">
                        <Text size="3" as="p" wrap="pretty">
                            My mission is to do "good" creative work, but this
                            is only achievable by rethinking what’s important:
                            putting people and the planet first. In that spirit,
                            I joined Creatives for Climate, a global network of
                            creative industry workers using their skills to
                            fight for the climate, and have been a member since
                            2025.
                        </Text>
                        <Text size="3" as="p" wrap="pretty">
                            While my practice is far from perfect, I use every
                            project as an opportunity to shape the change I want
                            to see. That said, I refuse to work with fossil fuel
                            clients or those who are directly associated with
                            the fossil fuel industry.
                        </Text>
                    </Flex>
                </Flex>
            </InnerSection>
            <InnerSection title="Recognitions" sectionId="recognitions">
                <Flex direction="column" gap="5">
                    <Text size="2" weight="medium">2026</Text>
                    <DataList.Root size="3">
                        <DataList.Item>
                            <DataList.Label>CSS Design Awards</DataList.Label>
                            <DataList.Value
                                >Special Kudos | francescoimola.com</DataList.Value
                            >
                        </DataList.Item>
                        <DataList.Item>
                            <DataList.Label>CSS Design Awards</DataList.Label>
                            <DataList.Value
                                >Public Awards &middot; Best UI, UX and
                                Innovation | francescoimola.com</DataList.Value
                            >
                        </DataList.Item>
                    </DataList.Root>
                    <Text size="2" weight="medium">2023</Text>
                    <DataList.Root size="3">
                        <DataList.Item>
                            <DataList.Label
                                >Read CV Homepage Feature</DataList.Label
                            >
                            <DataList.Value
                                >Breaking free from the algorithm | Substack
                                post</DataList.Value
                            >
                        </DataList.Item>
                        <DataList.Item>
                            <DataList.Label
                                >Read CV Homepage Feature</DataList.Label
                            >
                            <DataList.Value
                                >I fell into a sustainable design rabbit hole |
                                Substack post</DataList.Value
                            >
                        </DataList.Item>
                        <DataList.Item>
                            <DataList.Label
                                >Read CV Homepage Feature</DataList.Label
                            >
                            <DataList.Value
                                >Everything you see is in the past | Exhibition
                                Catalogue</DataList.Value
                            >
                        </DataList.Item>
                        <DataList.Item>
                            <DataList.Label
                                >Read CV Homepage Feature</DataList.Label
                            >
                            <DataList.Value
                                >How to Feel More at Home | artwork &middot; net
                                art</DataList.Value
                            >
                        </DataList.Item>
                    </DataList.Root>
                    <Text size="2" weight="medium">2021</Text>
                    <DataList.Root size="3">
                        <DataList.Item>
                            <DataList.Label>Special Special</DataList.Label>
                            <DataList.Value
                                >How to Feel More at Home | artwork &middot; net
                                art</DataList.Value
                            >
                        </DataList.Item>
                        <DataList.Item>
                            <DataList.Label
                                >Harbor Review &middot; Issue 04</DataList.Label
                            >
                            <DataList.Value
                                >'Untitled(2)' | artwork &middot; photography</DataList.Value
                            >
                        </DataList.Item>
                    </DataList.Root>
                </Flex>
            </InnerSection>
            <InnerSection title="Frequently asked questions" sectionId="faq">
                <Flex direction="column" gap="8">
                    <FAQ variant="about" client:visible />
                    <Flex direction="column" gap="3">
                        <Heading size="3" as="h3" weight="medium"
                            >Have a better question?</Heading
                        >
                        <Text size="3" as="p" mb="2">
                            Send me a message and we'll talk through everything.
                        </Text>
                        <ButtonLink
                            href="#contact"
                            size="3"
                            color="gray"
                            variant="soft"
                            style={{ alignSelf: "flex-start" }}
                        >
                            Scroll down to get in touch <ArrowDownIcon />
                        </ButtonLink>
                    </Flex>
                </Flex>
            </InnerSection>
        </MainGrid>
    </Section>
    <Section
        slot="bottom-cta"
        style={{
            backgroundColor: "var(--orange-5)",
        }}
        py="var(--space-10)"
    >
        <MainGrid>
            <InnerSection
                title="Knock on my door"
                sectionId="contact"
                showCounter={false}
            >
                <ContactSHeader slot="header" />
                <Flex direction="column" gap="6">
                    <Flex direction="column" gap="1">
                        <Heading size="3" as="h3" weight="medium"
                            >Send me a good 'ol email</Heading
                        >
                        <Link
                            href={`mailto:${SITE_DATA.email}`}
                            size="3"
                            highContrast
                            underline="always"
                        >
                            {SITE_DATA.email}
                        </Link>
                    </Flex>
                    <Flex direction="column" gap="1">
                        <Heading size="3" as="h3" weight="medium"
                            >Put a face to the name</Heading
                        >
                        <Link
                            href={`${EXTERNAL_URLS.calendar.intro}?description=direct-contact`}
                            target="_blank"
                            rel="noopener noreferrer"
                            size="3"
                            highContrast
                            underline="always"
                        >
                            Book a free introduction
                        </Link>
                    </Flex>
                    <Flex direction="column" gap="1">
                        <Heading size="3" as="h3" weight="medium"
                            >Prefer a form?</Heading
                        >
                        <Text size="3" highContrast> Fill the one below </Text>
                    </Flex>
                    <Flex direction="column" gap="1">
                        <Heading size="3" as="h3" weight="medium"
                            >Not sure what to say?</Heading
                        >
                        <TemplateDialog client:visible />
                    </Flex>
                    <ContactForm client:visible />
                </Flex>
            </InnerSection>
        </MainGrid>
    </Section>
</Layout>

<style>
    .about-grid {
        display: flex;
        flex-direction: row;

        @container (max-width: 520px) {
            flex-direction: column;

            .about-image {
                flex-basis: 100%;
            }
        }
    }

    .about-image {
        flex-basis: clamp(25%, 33%, 50%);
    }
</style>
