---
import {
    Theme,
    Grid,
    Box,
    Container,
    Flex,
    Link,
    Heading,
    Separator,
} from "@radix-ui/themes";
import "@radix-ui/themes/styles.css";
import "../styles/global.css";
import type { ComponentProps } from "react";
import { Footer } from "../components/Footer";
import Head from "../components/Head.astro";
import { ButtonLink } from "../components/ButtonLink";

interface Props extends ComponentProps<typeof Theme> {
    title?: string;
    description?: string;
    image?: string;
    ogType?: "website" | "article";
    backgroundColor?: string;
    roleFullWidth?: boolean;
    noIndex?: boolean;
}

const {
    title,
    description,
    image,
    ogType,
    backgroundColor = "var(--yellow-3)",
    roleFullWidth = false,
    noIndex = false,
    ...themeProps
} = Astro.props;
---

<html lang="en">
    <Head title={title} description={description} image={image} ogType={ogType} noIndex={noIndex}>
        <slot name="structured-data" slot="structured-data" />
    </Head>
    <body>
        <Theme
            accentColor="yellow"
            radius="none"
            grayColor="olive"
            panelBackground="solid"
            hasBackground={false}
            {...themeProps}
            style={{ backgroundColor }}
        >
            <Container maxWidth="var(--max-cw)">
                <!-- Hero Section -->
                <Grid
                    columns={{ initial: "1", md: "2" }}
                    gapY={{
                        initial: "var(--space-10)",
                        sm: "var(--space-11)",
                    }}
                    gapX="4"
                    pt="6"
                    pb="var(--space-10)"
                    className="side-margin"
                >
                    {/* Logo - Cell (1,1) */}
                    <Box
                        gridRow={{ initial: "auto", md: "1" }}
                        style={{
                            viewTransitionName: "site-logo",
                            alignSelf: "center",
                        }}
                    >
                        <Heading
                            size="3"
                            weight="medium"
                            highContrast
                            wrap="nowrap"
                            color="gray"
                        >
                            <Link href="/">Francesco Imola</Link>
                        </Heading>
                    </Box>

                    {/* Navigation + CTA - Cell (2,1) */}
                    <Flex
                        gridRow={{ initial: "auto", md: "1" }}
                        gridColumn={{ initial: "1", md: "2" }}
                        direction={{ initial: "column", md: "row" }}
                        justify="between"
                        align={{ initial: "start", md: "center" }}
                        gap={{ initial: "3", md: "5" }}
                        style={{ viewTransitionName: "site-nav" }}
                        wrap="wrap"
                    >
                        {/* Nav Items */}
                        <Flex
                            gap={{
                                initial: "3",
                                md: "4",
                            }}
                            direction="row"
                            align="center"
                            style={{
                                width: "max-content",
                            }}
                        >
                            <Link
                                href="/about"
                                size={{ initial: "2", md: "3" }}
                                color="gray"
                            >
                                About
                            </Link>
                            <Separator size="1" orientation="vertical" />
                            <Link
                                href="/webdesign"
                                size={{ initial: "2", md: "3" }}
                                color="gray"
                            >
                                Websites
                            </Link>
                            <Separator size="1" orientation="vertical" />
                            <Link
                                href="/consultations"
                                size={{ initial: "2", md: "3" }}
                                color="gray"
                            >
                                Consulting
                            </Link>
                            <Separator size="1" orientation="vertical" />
                            <Link
                                href="/blog"
                                size={{ initial: "2", md: "3" }}
                                color="gray"
                            >
                                Blog
                            </Link>
                            <Box
                                display={{
                                    initial: "contents",
                                    md: "none",
                                }}
                            >
                                <Separator size="1" orientation="vertical" />
                                <Link
                                    href="/about#contact"
                                    size={{ initial: "2", md: "3" }}
                                    color="gray"
                                >
                                    Contact
                                </Link>
                            </Box>
                        </Flex>

                        <Box
                            display={{ initial: "block", md: "none" }}
                            width="100%"
                        >
                            <Separator size="4" orientation="horizontal" />
                        </Box>

                        {/* Contact CTA */}
                        <Box display={{ initial: "none", md: "block" }}>
                            <ButtonLink
                                href="/about#contact"
                                variant="soft"
                                color="gray"
                                size={{ initial: "2", md: "3" }}
                            >
                                Contact
                            </ButtonLink>
                        </Box>
                    </Flex>

                    <Box
                        gridColumn={{ initial: "1", md: "2" }}
                        style={{
                            containerType: "inline-size",
                        }}
                    >
                        <slot name="heading" />
                    </Box>

                    <Box
                        gridColumn="1"
                        gridRow="auto"
                        width="full"
                        maxWidth={roleFullWidth
                            ? undefined
                            : {
                                  initial: "4",
                                  md: "var(--container-xs)",
                              }}
                    >
                        <slot name="role" />
                    </Box>

                    <Box gridColumn={{ initial: "1", md: "2" }} asChild>
                        <slot name="description" />
                    </Box>
                </Grid>
            </Container>

            <!-- Page Content -->
            <main class="content-enter">
                <slot name="page-content" />
                <slot name="bottom-cta" />
            </main>
            <Box style={{ viewTransitionName: "site-footer" }}>
                <Footer client:idle />
            </Box>
        </Theme>
    </body>
</html>
