---
import {
    Theme,
    Grid,
    Box,
    Container,
    Flex,
    Link,
    Heading,
    Separator,
} from "@radix-ui/themes";
import "@radix-ui/themes/styles.css";
import "../styles/global.css";
import type { ComponentProps } from "react";
import { Footer } from "../components/Footer";
import Head from "../components/Head.astro";
import { ButtonLink } from "../components/ButtonLink";

interface Props extends ComponentProps<typeof Theme> {
    title?: string;
    description?: string;
    image?: string;
    ogType?: "website" | "article";
    backgroundColor?: string;
    roleFullWidth?: boolean;
    noMobileRole?: boolean;
    noIndex?: boolean;
}

const {
    title,
    description,
    image,
    ogType,
    backgroundColor = "var(--yellow-3)",
    roleFullWidth = false,
    noMobileRole = false,
    noIndex = false,
    ...themeProps
} = Astro.props;
---

<html lang="en">
    <Head
        title={title}
        description={description}
        image={image}
        ogType={ogType}
        noIndex={noIndex}
    >
        <slot name="structured-data" slot="structured-data" />
    </Head>
    <body>
        <Theme
            accentColor="yellow"
            radius="none"
            grayColor="olive"
            panelBackground="solid"
            hasBackground={false}
            {...themeProps}
        >
            <Box
                className="hero-background"
                style={{ backgroundColor }}
                as="div"
            >
                <Container maxWidth="var(--max-cw)">
                    <!-- Hero Section -->
                    <Grid
                        columns={{ initial: "1", md: "2" }}
                        gapY="var(--space-12)"
                        gapX="4"
                        pt="6"
                        pb="var(--space-10)"
                        className="side-margin blog-hero-grid"
                    >
                        {/* Logo - Cell (1,1) */}
                        <Box
                            gridRow={{ initial: "auto", md: "1" }}
                            style={{
                                viewTransitionName: "site-logo",
                                alignSelf: "center",
                            }}
                        >
                            <Heading
                                size="3"
                                weight="medium"
                                highContrast
                                wrap="nowrap"
                                color="gray"
                            >
                                <Link href="/">Francesco Imola</Link>
                            </Heading>
                        </Box>

                        {/* Navigation + CTA - Cell (2,1) */}
                        <Flex
                            gridRow={{ initial: "auto", md: "1" }}
                            gridColumn={{ initial: "1", md: "2" }}
                            direction={{ initial: "column", md: "row" }}
                            justify="between"
                            align={{ initial: "start", md: "center" }}
                            gap={{ initial: "3", md: "5" }}
                            style={{ viewTransitionName: "site-nav" }}
                            wrap="wrap"
                        >
                            {/* Nav Items */}
                            <Flex
                                gap="4"
                                direction="row"
                                align="center"
                                style={{
                                    width: "max-content",
                                }}
                            >
                                <Link href="/about" size="3" color="gray">
                                    About
                                </Link>
                                <Separator size="1" orientation="vertical" />
                                <Link href="/work" size="3" color="gray">
                                    Work
                                </Link>
                                <Separator size="1" orientation="vertical" />
                                <Link href="/blog" size="3" color="gray">
                                    Blog
                                </Link>
                                <Box
                                    display={{
                                        initial: "contents",
                                        md: "none",
                                    }}
                                >
                                    <Separator
                                        size="1"
                                        orientation="vertical"
                                    />
                                    <Link
                                        href="/about#contact"
                                        size={{ initial: "2", md: "3" }}
                                        color="gray"
                                    >
                                        Contact
                                    </Link>
                                </Box>
                            </Flex>

                            <Box
                                display={{ initial: "block", md: "none" }}
                                width="100%"
                            >
                                <Separator size="4" orientation="horizontal" />
                            </Box>

                            {/* Contact CTA */}
                            <Box display={{ initial: "none", md: "block" }}>
                                <ButtonLink
                                    href="/about#contact"
                                    variant="soft"
                                    color="gray"
                                    size="3"
                                >
                                    Contact
                                </ButtonLink>
                            </Box>
                        </Flex>

                        <Box
                            gridColumn={{ initial: "1", md: "2" }}
                            style={{
                                containerType: "inline-size",
                            }}
                        >
                            <slot name="heading" />
                        </Box>

                        <Box
                            gridColumn="1"
                            gridRow="auto"
                            className={noMobileRole ? "role-hidden" : ""}
                            width="full"
                            maxWidth={roleFullWidth
                                ? undefined
                                : {
                                      initial: "4",
                                      md: "var(--container-xs)",
                                  }}
                        >
                            <slot name="role" />
                        </Box>

                        <Box gridColumn={{ initial: "1", md: "2" }} asChild>
                            <slot name="description" />
                        </Box>
                    </Grid>
                </Container>
            </Box>

            <!-- Page Content -->
            <main class="content-enter">
                <slot name="page-content" />
                <slot name="bottom-cta" />
            </main>
            <Box style={{ viewTransitionName: "site-footer" }}>
                <Footer client:visible />
            </Box>
        </Theme>
        <script>
            import Lenis from "lenis";

            const reducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            let lenisInstance: Lenis | undefined;

            function initLenis() {
                lenisInstance?.destroy();

                lenisInstance = new Lenis({
                    duration: reducedMotion ? 0.5 : 1.0,
                    easing: reducedMotion
                        ? (t: number) => t
                        : (t: number) =>
                              Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                    autoRaf: true,
                    anchors: true,
                });
            }

            initLenis();
            document.addEventListener("astro:page-load", initLenis);
        </script>
        <script>
            // Match Safari 26 Liquid Glass toolbar tint to visible section.
            // Hero visible → hero color, footer visible → footer color,
            // otherwise → olive-1 (from CSS).
            const hero = document.querySelector(".hero-background");
            const foot = document.querySelector("footer");
            let heroVis = false;
            let footVis = false;

            function syncBg() {
                if (heroVis) {
                    document.body.style.backgroundColor = heroBg;
                } else if (footVis) {
                    document.body.style.backgroundColor = footBg;
                } else {
                    document.body.style.backgroundColor = "";
                }
            }

            const heroBg = hero ? getComputedStyle(hero).backgroundColor : "";
            const footBg = foot ? getComputedStyle(foot).backgroundColor : "";

            if (hero || foot) {
                const io = new IntersectionObserver(
                    (entries) => {
                        for (const e of entries) {
                            if (e.target === hero) heroVis = e.isIntersecting;
                            else if (e.target === foot)
                                footVis = e.isIntersecting;
                        }
                        syncBg();
                    },
                    { threshold: 0 },
                );
                if (hero) io.observe(hero);
                if (foot) io.observe(foot);
            }
        </script>
    </body>
</html>

<style is:global>
    .hero-background {
        padding-top: env(safe-area-inset-top, 0px);
    }

    /* Edge blur overlays.
       Effects live on ::after so Safari 26 doesn't sample them
       for Liquid Glass toolbar tinting (pseudo-elements are ignored). */
    .edge-blur {
        position: fixed;
        left: 0;
        right: 0;
        height: clamp(5rem, 12vh, 15rem);
        z-index: var(--z-overlay);
        pointer-events: none;
    }

    .edge-blur::after {
        content: "";
        position: absolute;
        inset: 0;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }

    .edge-blur--top {
        top: 0;
        opacity: 0;
        transition: opacity 0.4s ease;
        view-transition-name: blur-top;
    }

    .edge-blur--top::after {
        mask-image: linear-gradient(to bottom, black, transparent);
        -webkit-mask-image: linear-gradient(to bottom, black, transparent);
    }

    .edge-blur--top[data-visible] {
        opacity: 1;
    }

    .edge-blur--bottom {
        bottom: 0;
        view-transition-name: blur-bottom;
    }

    .edge-blur--bottom::after {
        mask-image: linear-gradient(to top, black, transparent);
        -webkit-mask-image: linear-gradient(to top, black, transparent);
    }

    @media (prefers-reduced-motion: reduce) {
        .edge-blur--top {
            transition-duration: 0.15s;
        }
    }
</style>

<style>
    /* Content Entrance (Slide Up) */
    @media (prefers-reduced-motion: no-preference) {
        .content-enter {
            animation: slide-up-fade 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
    }

    @keyframes slide-up-fade {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
    }
</style>
