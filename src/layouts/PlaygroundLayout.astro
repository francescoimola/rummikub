---
import {
    Theme,
    Box,
} from "@radix-ui/themes";
import "@radix-ui/themes/styles.css";
import "../styles/global.css";
import type { ComponentProps } from "react";
import { Footer } from "../components/Footer";
import Head from "../components/Head.astro";

interface Props extends ComponentProps<typeof Theme> {
    title?: string;
    description?: string;
    image?: string;
    ogType?: "website" | "article";
    noIndex?: boolean;
}

const {
    title,
    description,
    image,
    ogType,
    noIndex = false,
    ...themeProps
} = Astro.props;
---

<html lang="en">
    <Head
        title={title}
        description={description}
        image={image}
        ogType={ogType}
        noIndex={noIndex}
    />
    <body style="background-color: var(--brand-surface-dark-mustard)">
        <Theme
            accentColor="yellow"
            radius="none"
            grayColor="olive"
            panelBackground="solid"
            hasBackground={false}
            {...themeProps}
        >
            <!-- Split wrapper: 2-column grid on desktop, single column on mobile -->
            <div class="playground-split">
                <!-- LEFT: Sticky image column -->
                <div class="playground-split__image">
                    <slot name="image" />
                </div>

                <!-- RIGHT: Hero + scrollable content -->
                <div class="playground-split__content">
                    <!-- Hero section (dark theme) -->
                    <Box
                        className="hero-background playground-hero"
                        style={{ backgroundColor: "var(--brand-surface-dark-mustard)" }}
                        as="div"
                    >
                        <slot name="hero" />
                    </Box>

                    <!-- Page content -->
                    <main class="content-enter">
                        <slot name="page-content" />
                    </main>
                </div>
            </div>

            <!-- Footer: full-width, outside split -->
            <Box style={{ viewTransitionName: "site-footer" }}>
                <Footer client:visible />
            </Box>

        </Theme>

        <script>
            import "../scripts/smooth-scroll";
        </script>

        <script>
            import "../scripts/liquid-glass";
        </script>

        <!-- Copy email link functionality -->
        <script>
            import { SITE_DATA } from "../constants";

            function initCopyEmail() {
                const copyLinks = document.querySelectorAll(".copy-email-link");
                copyLinks.forEach((link) => {
                    link.addEventListener("click", (e) => {
                        e.preventDefault();
                        void navigator.clipboard.writeText(SITE_DATA.email);
                        const originalText = link.textContent;
                        link.textContent = "Copied!";
                        setTimeout(() => {
                            link.textContent = originalText;
                        }, 2000);
                    });
                });
            }

            initCopyEmail();
            document.addEventListener("astro:page-load", initCopyEmail);
        </script>
    </body>
</html>

<style is:global>
    /* ── Split Layout Grid ── */
    .playground-split {
        display: grid;
        grid-template-columns: 1fr;
        min-height: 100dvh;
    }

    @media (min-width: 1024px) {
        .playground-split {
            display: block;
        }
    }

    /* ── Left Column: Sticky Image ── */
    .playground-split__image {
        /* Mobile: static, aspect ratio constrained */
        position: static;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: var(--gray-3);
    }

    .playground-split__image img,
    .playground-split__image picture {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .playground-split__image picture img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* ── Hero Image Fade-in ── */
    .hero-image {
        animation: hero-fade-in 0.6s ease-out;
    }

    @keyframes hero-fade-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @media (min-width: 1024px) {
        .playground-split__image {
            position: fixed;
            top: 0;
            left: 0;
            width: 40%;
            height: 100dvh;
            aspect-ratio: auto;
        }

        .playground-split__content {
            margin-left: 40%;
        }
    }

    /* ── Right Column: Scrollable Content ── */
    .playground-split__content {
        min-width: 0; /* Prevent grid blowout */
    }

    /* ── Playground Hero (right column) ── */
    .playground-hero {
        padding-top: env(safe-area-inset-top, 0px);
    }

    /* ── Hero Inner Content Area ── */
    .playground-hero-inner {
        padding-inline: 5cqmin;
        max-width: var(--max-cw);
        margin-inline: auto;
    }
</style>
