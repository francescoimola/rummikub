---
import {
    Theme,
    Box,
} from "@radix-ui/themes";
import "@radix-ui/themes/styles.css";
import "../styles/global.css";
import type { ComponentProps } from "react";
import { Footer } from "../components/Footer";
import Head from "../components/Head.astro";

interface Props extends ComponentProps<typeof Theme> {
    title?: string;
    description?: string;
    image?: string;
    ogType?: "website" | "article";
    noIndex?: boolean;
}

const {
    title,
    description,
    image,
    ogType,
    noIndex = false,
    ...themeProps
} = Astro.props;
---

<html lang="en">
    <Head
        title={title}
        description={description}
        image={image}
        ogType={ogType}
        noIndex={noIndex}
    />
    <body>
        <Theme
            accentColor="yellow"
            radius="none"
            grayColor="olive"
            panelBackground="solid"
            hasBackground={false}
            {...themeProps}
        >
            <!-- Split wrapper: 2-column grid on desktop, single column on mobile -->
            <div class="playground-split">
                <!-- LEFT: Sticky image column -->
                <div class="playground-split__image">
                    <slot name="image" />
                </div>

                <!-- RIGHT: Hero + scrollable content -->
                <div class="playground-split__content">
                    <!-- Hero section (dark theme) -->
                    <Box
                        className="hero-background playground-hero"
                        style={{ backgroundColor: "var(--brand-surface-dark-mustard)" }}
                        as="div"
                    >
                        <slot name="hero" />
                    </Box>

                    <!-- Page content -->
                    <main class="content-enter">
                        <slot name="page-content" />
                    </main>
                </div>
            </div>

            <!-- Footer: full-width, outside split -->
            <Box style={{ viewTransitionName: "site-footer" }}>
                <Footer client:visible />
            </Box>

            <div class="edge-blur edge-blur--top" aria-hidden="true"></div>
            <div class="edge-blur edge-blur--bottom" aria-hidden="true"></div>
        </Theme>

        <!-- Lenis smooth-scrolling script -->
        <script>
            import Lenis from "lenis";

            const reducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            let lenisInstance: Lenis | undefined;

            function initLenis() {
                lenisInstance?.destroy();

                lenisInstance = new Lenis({
                    duration: reducedMotion ? 0.5 : 1.0,
                    easing: reducedMotion
                        ? (t: number) => t
                        : (t: number) =>
                              Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                    autoRaf: true,
                    anchors: true,
                });
            }

            initLenis();
            document.addEventListener("astro:page-load", initLenis);
        </script>

        <!-- Edge blur + Liquid Glass script -->
        <script>
            const topBlur = document.querySelector(".edge-blur--top");
            function update() {
                topBlur?.toggleAttribute("data-visible", window.scrollY > 40);
            }
            update();
            window.addEventListener("scroll", update, { passive: true });

            // Match Safari 26 Liquid Glass toolbar tint to visible section.
            // Hero visible → hero color, footer visible → footer color,
            // otherwise → olive-1 (from CSS).
            const hero = document.querySelector(".hero-background");
            const foot = document.querySelector("footer");
            let heroVis = false;
            let footVis = false;

            function syncBg() {
                if (heroVis) {
                    document.body.style.backgroundColor = heroBg;
                } else if (footVis) {
                    document.body.style.backgroundColor = footBg;
                } else {
                    document.body.style.backgroundColor = "";
                }
            }

            const heroBg = hero ? getComputedStyle(hero).backgroundColor : "";
            const footBg = foot ? getComputedStyle(foot).backgroundColor : "";

            if (hero || foot) {
                const io = new IntersectionObserver(
                    (entries) => {
                        for (const e of entries) {
                            if (e.target === hero) heroVis = e.isIntersecting;
                            else if (e.target === foot)
                                footVis = e.isIntersecting;
                        }
                        syncBg();
                    },
                    { threshold: 0 },
                );
                if (hero) io.observe(hero);
                if (foot) io.observe(foot);
            }
        </script>

        <!-- Copy email link functionality -->
        <script>
            import { SITE_DATA } from "../constants";

            function initCopyEmail() {
                const copyLinks = document.querySelectorAll(".copy-email-link");
                copyLinks.forEach((link) => {
                    link.addEventListener("click", (e) => {
                        e.preventDefault();
                        void navigator.clipboard.writeText(SITE_DATA.email);
                        const originalText = link.textContent;
                        link.textContent = "Copied!";
                        setTimeout(() => {
                            link.textContent = originalText;
                        }, 2000);
                    });
                });
            }

            initCopyEmail();
            document.addEventListener("astro:page-load", initCopyEmail);
        </script>
    </body>
</html>

<style is:global>
    /* ── Split Layout Grid ── */
    .playground-split {
        display: grid;
        grid-template-columns: 1fr; /* Mobile: single column */
        min-height: 100vh;
    }

    @media (min-width: 1024px) {
        .playground-split {
            display: block; /* Disable grid on desktop, use fixed positioning instead */
        }
    }

    /* ── Left Column: Sticky Image ── */
    .playground-split__image {
        /* Mobile: static, aspect ratio constrained */
        position: static;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: var(--gray-3);
    }

    .playground-split__image img,
    .playground-split__image picture {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .playground-split__image picture img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* ── Hero Image Fade-in ── */
    .hero-image {
        animation: hero-fade-in 0.6s ease-out;
    }

    @keyframes hero-fade-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @media (min-width: 1024px) {
        .playground-split__image {
            position: fixed;
            top: 0;
            left: 0;
            width: 40%;
            height: 100vh;
            aspect-ratio: auto; /* Override mobile aspect-ratio */
        }

        .playground-split__content {
            margin-left: 40%; /* Offset for fixed image column */
        }
    }

    /* ── Right Column: Scrollable Content ── */
    .playground-split__content {
        min-width: 0; /* Prevent grid blowout */
    }

    /* ── Playground Hero (right column) ── */
    .playground-hero {
        padding-top: env(safe-area-inset-top, 0px);
    }

    /* ── Hero Inner Content Area ── */
    .playground-hero-inner {
        padding-inline: 5cqmin;
        max-width: var(--max-cw);
        margin-inline: auto;
    }

    /* Edge blur overlays.
       Effects live on ::after so Safari 26 doesn't sample them
       for Liquid Glass toolbar tinting (pseudo-elements are ignored). */
    .edge-blur {
        position: fixed;
        left: 0;
        right: 0;
        height: clamp(5rem, 12vh, 15rem);
        z-index: var(--z-overlay);
        pointer-events: none;
    }

    .edge-blur::after {
        content: "";
        position: absolute;
        inset: 0;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }

    .edge-blur--top {
        top: 0;
        opacity: 0;
        transition: opacity 0.4s ease;
        view-transition-name: blur-top;
    }

    .edge-blur--top::after {
        mask-image: linear-gradient(to bottom, black, transparent);
        -webkit-mask-image: linear-gradient(to bottom, black, transparent);
    }

    .edge-blur--top[data-visible] {
        opacity: 1;
    }

    .edge-blur--bottom {
        bottom: 0;
        view-transition-name: blur-bottom;
    }

    .edge-blur--bottom::after {
        mask-image: linear-gradient(to top, black, transparent);
        -webkit-mask-image: linear-gradient(to top, black, transparent);
    }

    @media (prefers-reduced-motion: reduce) {
        .edge-blur--top {
            transition-duration: 0.15s;
        }
    }
</style>

<style>
    /* Content Entrance (Slide Up) */
    @media (prefers-reduced-motion: no-preference) {
        .content-enter {
            animation: slide-up-fade 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
    }

    @keyframes slide-up-fade {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
    }
</style>
