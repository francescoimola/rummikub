---
import { Image } from "astro:assets";
import {
    AspectRatio,
    Badge,
    Box,
    Button,
    Flex,
    Heading,
    Text,
} from "@radix-ui/themes";
import { ArrowRightIcon } from "@radix-ui/react-icons";

interface Props {
    images?: (string | ImageMetadata)[];
    title?: string;
    skills?: string[];
    href?: string;
    caseStudyStatus?: "coming-soon" | "on-request";
}

const { images = [], title, skills = [], href, caseStudyStatus } = Astro.props;

// Badge text based on status
const statusBadgeText =
    caseStudyStatus === "coming-soon"
        ? "Case study coming soon"
        : caseStudyStatus === "on-request"
          ? "Available on request"
          : null;

const PLACEHOLDERS = [
    "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe",
    "https://images.unsplash.com/photo-1614851099511-773084f6911d",
    "https://images.unsplash.com/photo-1620641788421-7a1c342ea42e",
];

const finalImages = [...images, ...PLACEHOLDERS.slice(images.length, 3)];

const isDraft = !href && caseStudyStatus;
const Container: any = href ? "a" : Flex;
const elementProps = href
    ? {
          href,
          class: "project-canvas-container project-canvas-link",
      }
    : {
          className: `project-canvas-container${isDraft ? " project-canvas-draft" : ""}`,
          direction: "column",
          gap: "5",
          tabIndex: isDraft ? 0 : undefined,
      };
---

{
    (
        <Container {...elementProps}>
            {/* Image Canvas */}
            <AspectRatio ratio={3 / 2}>
                <Flex
                    overflow="hidden"
                    align="center"
                    justify="center"
                    className="project-canvas-image-wrapper"
                >
                    {/* Status badge - always visible when set */}
                    {statusBadgeText && (
                        <Badge
                            size="1"
                            color="gray"
                            variant="soft"
                            className="project-canvas-status-badge"
                        >
                            {statusBadgeText}
                        </Badge>
                    )}

                    {/* Hover content: arrow for regular projects, status text for drafts */}
                    {isDraft ? (
                        <Text size="2" weight="medium" className="hover-text">
                            {statusBadgeText}
                        </Text>
                    ) : (
                        <Button
                            variant="ghost"
                            tabIndex={-1}
                            className="hover-button"
                            highContrast
                        >
                            <ArrowRightIcon
                                style={{
                                    width: "var(--space-4)",
                                    height: "auto",
                                }}
                            />
                        </Button>
                    )}

                    <Flex
                        width="120%"
                        height="80%"
                        align="center"
                        justify="center"
                        gap="4"
                    >
                        {finalImages.map((src, i) => (
                            <Box key={i} className="project-canvas-image-item">
                                {typeof src === "string" ? (
                                    <Image
                                        src={src}
                                        alt=""
                                        inferSize={true}
                                        class="project-canvas-image"
                                    />
                                ) : (
                                    <Image
                                        src={src}
                                        alt=""
                                        class="project-canvas-image"
                                    />
                                )}
                            </Box>
                        ))}
                    </Flex>
                </Flex>
            </AspectRatio>

            {/* Title and Skills */}
            {(title || skills.length > 0) && (
                <Flex
                    direction="row"
                    justify="between"
                    align="baseline"
                    gapX="6"
                    gapY="3"
                    wrap="wrap"
                >
                    {title && (
                        <Heading
                            as="h2"
                            size="3"
                            weight="medium"
                            highContrast
                            style={{ alignSelf: "flex-start" }}
                        >
                            {title}
                        </Heading>
                    )}
                    {skills.length > 0 && (
                        <Flex
                            gap="2"
                            wrap="wrap"
                            style={{ alignSelf: "flex-start" }}
                        >
                            {skills.map((skill) => (
                                <Badge size="2" color="gray" variant="surface">
                                    {skill}
                                </Badge>
                            ))}
                        </Flex>
                    )}
                </Flex>
            )}
        </Container>
    )
}
