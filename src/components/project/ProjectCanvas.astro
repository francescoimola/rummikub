---
import { Picture } from "astro:assets";
import {
    AspectRatio,
    Badge,
    Box,
    Button,
    Flex,
    Heading,
    Text,
} from "@radix-ui/themes";
import { ArrowRightIcon } from "@radix-ui/react-icons";
import type { ImageMetadata } from "astro";

interface Props {
    images?: (string | ImageMetadata)[];
    layout?: "default" | "plain";
    title?: string;
    skills?: string[];
    href?: string;
    caseStudyStatus?: "coming-soon" | "on-request";
}

const {
    images = [],
    layout = "default",
    title,
    skills = [],
    href,
    caseStudyStatus,
} = Astro.props;

const isPlain = layout === "plain";
const isDuo = images.length === 2;
const isDraft = !href && !!caseStudyStatus;

const statusText =
    {
        "coming-soon": "Case study coming soon",
        "on-request": "Available on request",
    }[caseStudyStatus as string] ?? null;

const Container = href ? "a" : Flex;
const containerProps = href
    ? { href, class: "project-canvas-container project-canvas-link" }
    : {
          className: `project-canvas-container${isDraft ? " project-canvas-draft" : ""}`,
          direction: "column" as const,
          gap: "5",
          tabIndex: isDraft ? 0 : undefined,
      };
---

<Container {...containerProps}>
    <AspectRatio ratio={3 / 2}>
        <Flex
            overflow="hidden"
            align="center"
            justify="center"
            width="100%"
            height="100%"
            className="project-canvas-image-wrapper"
        >
            {/* Status Badge */}
            {
                statusText && (
                    <Badge
                        size="2"
                        color="gray"
                        variant="surface"
                        className="project-canvas-status-badge"
                    >
                        {statusText}
                    </Badge>
                )
            }

            {/* Hover Overlay */}
            {
                isDraft ? (
                    <Text size="2" weight="medium" className="hover-text">
                        {statusText}
                    </Text>
                ) : href ? (
                    <Button
                        variant="ghost"
                        tabIndex={-1}
                        className="hover-button"
                        highContrast
                        aria-label="View project details"
                    >
                        <ArrowRightIcon
                            style={{ width: "var(--space-4)", height: "auto" }}
                        />
                    </Button>
                ) : null
            }

            {/* Image Content */}
            {
                isPlain ? (
                    images[0] &&
                    (typeof images[0] === "string" ? (
                        <Picture
                            src={images[0]}
                            alt=""
                            formats={["avif", "webp"]}
                            class="project-canvas-plain-image"
                            inferSize={true}
                        />
                    ) : (
                        <Picture
                            src={images[0]}
                            alt=""
                            formats={["avif", "webp"]}
                            class="project-canvas-plain-image"
                        />
                    ))
                ) : (
                    <Flex
                        width={isDuo ? "100%" : "120%"}
                        height={isDuo ? "100%" : "80%"}
                        align="center"
                        justify="center"
                        gap="3"
                        className={isDuo ? "project-canvas-duo" : undefined}
                    >
                        {images.map((src, i) => (
                            <Box
                                key={i}
                                className={`project-canvas-image-item${isDuo ? " project-canvas-image-duo" : ""}`}
                            >
                                {typeof src === "string" ? (
                                    <Picture
                                        src={src}
                                        alt=""
                                        formats={["avif", "webp"]}
                                        class="project-canvas-image"
                                        inferSize={true}
                                    />
                                ) : (
                                    <Picture
                                        src={src}
                                        alt=""
                                        formats={["avif", "webp"]}
                                        class="project-canvas-image"
                                    />
                                )}
                            </Box>
                        ))}
                    </Flex>
                )
            }
        </Flex>
    </AspectRatio>

    {/* Footer Info */}
    {
        (title || skills.length > 0) && (
            <Flex
                direction="row"
                justify="between"
                align="baseline"
                gapX="6"
                gapY="3"
                wrap="wrap"
            >
                {title && (
                    <Heading
                        as="h2"
                        size="3"
                        weight="medium"
                        highContrast
                        style={{ alignSelf: "flex-start" }}
                    >
                        {title}
                    </Heading>
                )}
                {skills.length > 0 && (
                    <Flex
                        gap="2"
                        wrap="wrap"
                        style={{ alignSelf: "flex-start" }}
                    >
                        {skills.map((skill) => (
                            <Badge
                                key={skill}
                                size="2"
                                color="gray"
                                variant="surface"
                            >
                                {skill}
                            </Badge>
                        ))}
                    </Flex>
                )}
            </Flex>
        )
    }
</Container>
