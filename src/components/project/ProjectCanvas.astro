---
import { Picture } from "astro:assets";
import {
    AspectRatio,
    Badge,
    Box,
    Button,
    Flex,
    Heading,
    Text,
} from "@radix-ui/themes";
import { ArrowRightIcon } from "@radix-ui/react-icons";
import type { ImageMetadata } from "astro";

interface Props {
    images?: (string | ImageMetadata)[];
    layout?: "default" | "plain";
    title?: string;
    skills?: string[];
    href?: string;
    caseStudyStatus?: "coming-soon" | "on-request";
}

const {
    images = [],
    layout = "default",
    title,
    skills = [],
    href,
    caseStudyStatus,
} = Astro.props;

const isPlain = layout === "plain";
const isDuo = images.length === 2;
const isDraft = !href && !!caseStudyStatus;

const statusText =
    {
        "coming-soon": "Case study coming soon",
        "on-request": "Available on request",
    }[caseStudyStatus as string] ?? null;

const Container = href ? "a" : Flex;
const containerProps = href
    ? { href, class: "project-canvas-container project-canvas-link" }
    : {
          className: `project-canvas-container${isDraft ? " project-canvas-draft" : ""}`,
          direction: "column" as const,
          gap: "5",
          tabIndex: isDraft ? 0 : undefined,
      };
---

<Container {...containerProps}>
    <AspectRatio ratio={3 / 2}>
        <Flex
            overflow="hidden"
            align="center"
            justify="center"
            width="100%"
            height="100%"
            className="project-canvas-image-wrapper"
        >
            {/* Status Badge */}
            {
                statusText && (
                    <Badge
                        size="2"
                        color="gray"
                        variant="surface"
                        className="project-canvas-status-badge"
                    >
                        {statusText}
                    </Badge>
                )
            }

            {/* Hover Overlay */}
            {
                isDraft ? (
                    <Text size="2" weight="medium" className="hover-text">
                        {statusText}
                    </Text>
                ) : href ? (
                    <Button
                        variant="ghost"
                        tabIndex={-1}
                        className="hover-button"
                        highContrast
                        aria-label="View project details"
                    >
                        <ArrowRightIcon
                            style={{ width: "var(--space-4)", height: "auto" }}
                        />
                    </Button>
                ) : null
            }

            {/* Image Content */}
            {
                isPlain ? (
                    images[0] &&
                    (typeof images[0] === "string" ? (
                        <Picture
                            src={images[0]}
                            alt=""
                            formats={["avif", "webp"]}
                            class="project-canvas-plain-image"
                            inferSize={true}
                        />
                    ) : (
                        <Picture
                            src={images[0]}
                            alt=""
                            formats={["avif", "webp"]}
                            class="project-canvas-plain-image"
                        />
                    ))
                ) : (
                    <Flex
                        width={isDuo ? "100%" : "120%"}
                        height={isDuo ? "100%" : "80%"}
                        align="center"
                        justify="center"
                        gap="3"
                        className={isDuo ? "project-canvas-duo" : undefined}
                    >
                        {images.map((src, i) => (
                            <Box
                                key={i}
                                className={`project-canvas-image-item${isDuo ? " project-canvas-image-duo" : ""}`}
                            >
                                {typeof src === "string" ? (
                                    <Picture
                                        src={src}
                                        alt=""
                                        formats={["avif", "webp"]}
                                        class="project-canvas-image"
                                        inferSize={true}
                                    />
                                ) : (
                                    <Picture
                                        src={src}
                                        alt=""
                                        formats={["avif", "webp"]}
                                        class="project-canvas-image"
                                    />
                                )}
                            </Box>
                        ))}
                    </Flex>
                )
            }
        </Flex>
    </AspectRatio>

    {/* Footer Info */}
    {
        (title || skills.length > 0) && (
            <Flex
                direction="row"
                justify="between"
                align="baseline"
                gapX="6"
                gapY="3"
                wrap="wrap"
            >
                {title && (
                    <Heading
                        as="h2"
                        size="3"
                        weight="medium"
                        highContrast
                        style={{ alignSelf: "flex-start" }}
                    >
                        {title}
                    </Heading>
                )}
                {skills.length > 0 && (
                    <Flex
                        gap="2"
                        wrap="wrap"
                        style={{ alignSelf: "flex-start" }}
                    >
                        {skills.map((skill) => (
                            <Badge
                                key={skill}
                                size="2"
                                color="gray"
                                variant="surface"
                            >
                                {skill}
                            </Badge>
                        ))}
                    </Flex>
                )}
            </Flex>
        )
    }
</Container>

<style>
    /* --- Project Canvas --- */
    .project-canvas-container {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        color: inherit;
        text-decoration: none;

        &:hover .hover-button {
            transform: scale(1);
            opacity: 1;
        }
    }

    .project-canvas-link {
        &:focus-visible {
            outline: 2px solid var(--accent-a8);
            outline-offset: 2px;
        }

        &:hover,
        &:focus-visible {
            .project-canvas-heading,
            .project-desc-clip,
            .project-canvas-image-item {
                opacity: 0.7;
            }

            .project-canvas-image-wrapper::after {
                opacity: 1;
            }

            .hover-button {
                transform: scale(1);
                opacity: 1;
            }
        }
    }

    .project-canvas-heading,
    .project-desc-clip,
    .project-canvas-image-item,
    .project-canvas-image-wrapper {
        transition:
            opacity var(--transition-fast) ease-in-out,
            background-color var(--transition-fast) ease-in-out;
    }

    .project-canvas-image-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        background-color: var(--gray-3);

        &::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 9;
            background-color: var(--yellow-6);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease-in-out;
        }
    }

    .hover-button {
        position: absolute;
        z-index: 10;
        transform: scale(0.8);
        opacity: 0;
        cursor: pointer;
        transition:
            opacity var(--transition-fast) ease-in-out,
            transform var(--transition-fast) ease-in-out;
    }

    /* Hover text for draft projects (shown instead of arrow) */
    .hover-text {
        position: absolute;
        z-index: 10;
        opacity: 0;
        color: var(--gray-a12);
        text-align: center;
        transition: opacity var(--transition-fast) ease-in-out;
        user-select: none;
    }

    /* Status badge in top-right corner */
    .project-canvas-status-badge {
        position: absolute;
        top: var(--space-3);
        right: var(--space-3);
        z-index: 11;
        transition:
            transform var(--transition-fast) ease-in-out,
            opacity var(--transition-fast) ease-in-out;
        user-select: none;
    }

    /* Draft project container styles */
    .project-canvas-draft {
        /* Use a more muted overlay color for draft projects */
        .project-canvas-image-wrapper::after {
            background-color: var(--yellow-3);
        }

        &:hover,
        &:focus-visible {
            .project-canvas-image-item {
                opacity: 0.7;
            }

            .project-canvas-image-wrapper::after {
                opacity: 1;
            }

            .hover-text {
                opacity: 1;
            }

            .project-canvas-status-badge {
                opacity: 0;
            }
        }

        &:focus-visible {
            outline: 2px solid var(--accent-a8);
            outline-offset: 2px;
        }

        /* Click feedback - pulse the badge */
        &:active .project-canvas-status-badge {
            transform: scale(1.1);
        }
    }

    .project-canvas-image-item {
        flex-shrink: 0;
        aspect-ratio: 2 / 3;
        height: 100%;
    }

    /* Duo layout - 2 images side by side with landscape aspect ratio */
    .project-canvas-image-duo {
        aspect-ratio: 5 / 4;
        height: 80%;
        width: auto;
        overflow: hidden;
        filter: drop-shadow(0.25rem 0.25rem 0.25rem var(--gray-a3));
        border: thin solid var(--gray-a3);
    }

    .project-canvas-image-duo:first-child .project-canvas-image {
        object-position: top right;
    }

    .project-canvas-image-duo:last-child .project-canvas-image {
        object-position: top left;
    }

    .project-canvas-image-duo .project-canvas-image {
        filter: none;
        border: none;
    }

    .project-canvas-image-wrapper picture,
    .project-canvas-image-item picture {
        display: contents;
    }

    .project-canvas-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        filter: drop-shadow(0.25rem 0.25rem 0.25rem var(--gray-a3));
        border: thin solid var(--gray-a3);
    }

    .project-canvas-plain-image {
        height: clamp(12rem, 60% + 3vw, 80%);
        width: auto;
        max-width: 85%;
        object-fit: contain;
        filter: drop-shadow(0.25rem 0.25rem 0.5rem var(--gray-a4))
            drop-shadow(0 0 0.5px var(--gray-a4))
            drop-shadow(0 0 0.5px var(--gray-a4));
    }
</style>
