---
import { AspectRatio, Flex, Text } from "@radix-ui/themes";
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"figure"> {
    src?: ImageMetadata;
    image?: ImageMetadata; // Legacy support
    alt: string;
    caption?: string;
    title?: string;
    className?: string; // Legacy support
}

const {
    src,
    image,
    alt,
    caption,
    title,
    className,
    class: clazz,
    ...rest
} = Astro.props;
const finalImage = image ?? src;

if (!finalImage) {
    throw new Error("ProjectImage: 'src' or 'image' prop is required");
}

let mode: "plain" | "filled" | "framed" = "plain";
let finalCaption = caption;

if (title) {
    if (title === "framed" || title.startsWith("framed:")) {
        mode = "framed";
        finalCaption ??= title === "framed" ? undefined : title.slice(7).trim();
    } else if (title.startsWith("filled:")) {
        mode = "filled";
        finalCaption ??= title.slice(7).trim();
    } else if (title.startsWith("plain:")) {
        mode = "plain";
        finalCaption ??= title.slice(6).trim();
    } else {
        // No explicit mode prefix, treat as caption
        finalCaption ??= title;
        // Default behavior: frame if there is a caption
        if (finalCaption) mode = "framed";
    }
} else if (finalCaption) {
    // No title, but caption prop exists -> default to framed
    mode = "framed";
}

// Clean up empty strings
if (!finalCaption) finalCaption = undefined;

const FRAMED_SHADOW =
    "drop-shadow(0.25rem 0.25rem 0.5rem var(--gray-a4)) drop-shadow(0 0 0.5px var(--gray-a4)) drop-shadow(0 0 0.5px var(--gray-a4))";
---

<figure class:list={[className, clazz, "image-text-spacing"]} {...rest}>
    {
        mode === "framed" ? (
            <AspectRatio ratio={3 / 2} style={{ overflow: "hidden" }}>
                <Flex
                    width="100%"
                    height="100%"
                    py="9"
                    px={{ initial: "4", sm: "8" }}
                    align="end"
                    justify="center"
                    style={{ backgroundColor: "var(--gray-3)" }}
                >
                    <Image
                        src={finalImage}
                        alt={alt}
                        loading="lazy"
                        style={{
                            height: "100%",
                            width: "auto",
                            maxWidth: "100%",
                            objectPosition: "top",
                            objectFit: "contain",
                            filter: FRAMED_SHADOW,
                        }}
                    />
                </Flex>
            </AspectRatio>
        ) : (
            <Image
                src={finalImage}
                alt={alt}
                loading="lazy"
                style={{
                    width: "100%",
                    height: "auto",
                    backgroundColor:
                        mode === "filled" ? "var(--gray-3)" : undefined,
                }}
            />
        )
    }

    {
        finalCaption && (
            <Text size="2" color="gray" asChild>
                <figcaption>{finalCaption}</figcaption>
            </Text>
        )
    }
</figure>
