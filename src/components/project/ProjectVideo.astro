---
import { Text } from "@radix-ui/themes";

interface Props {
    src: string;
    alt: string;
    caption?: string;
    title?: string;
}

const { src, alt, caption, title } = Astro.props;
const finalCaption = caption ?? title ?? undefined;
---

<figure class="project-video image-text-spacing">
    <div class="project-video-wrapper">
        <video
            class="project-video-el"
            data-src={src}
            muted
            loop
            playsinline
            preload="none"
            aria-label={alt}></video>
        <button
            class="project-video-play"
            type="button"
            aria-label="Play video"
        >
            <svg
                width="48"
                height="48"
                viewBox="0 0 48 48"
                fill="none"
                aria-hidden="true"
            >
                <circle cx="24" cy="24" r="24" fill="rgba(0,0,0,0.45)"></circle>
                <path d="M19 15l14 9-14 9V15z" fill="white"></path>
            </svg>
        </button>
    </div>
    {
        finalCaption && (
            <Text size="2" color="gray" asChild>
                <figcaption>{finalCaption}</figcaption>
            </Text>
        )
    }
</figure>

<style>
    .project-video-wrapper {
        position: relative;
        width: 100%;
        background-color: var(--gray-3);
    }

    .project-video-el {
        width: 100%;
        height: auto;
        display: block;
    }

    .project-video-play {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        border: none;
        background: none;
        cursor: pointer;
        padding: 0;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
        z-index: 1;
    }

    .project-video-play[data-visible] {
        opacity: 1;
        pointer-events: auto;
    }
</style>

<script>
    function initProjectVideos() {
        const wrappers = document.querySelectorAll(".project-video-wrapper");
        const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        );

        const conn = (navigator as any).connection;
        const slowConnection =
            conn?.saveData === true ||
            conn?.effectiveType === "slow-2g" ||
            conn?.effectiveType === "2g";

        wrappers.forEach((wrapper) => {
            const video = wrapper.querySelector(
                ".project-video-el",
            ) as HTMLVideoElement;
            const btn = wrapper.querySelector(
                ".project-video-play",
            ) as HTMLButtonElement;
            if (!video || !btn) return;

            // Skip if already initialised (e.g. after view-transition)
            if (video.dataset.init) return;
            video.dataset.init = "1";

            let inView = false;
            let loaded = false;

            const showBtn = () => btn.setAttribute("data-visible", "");
            const hideBtn = () => btn.removeAttribute("data-visible");

            // Set the real src from data-src (once)
            const ensureLoaded = () => {
                if (loaded) return;
                const lazySrc = video.dataset.src;
                if (lazySrc) {
                    video.src = lazySrc;
                    loaded = true;
                }
            };

            const tryPlay = () => {
                ensureLoaded();
                video
                    .play()
                    .then(hideBtn)
                    .catch(() => showBtn());
            };

            // Reduced-motion or slow connection: show button, don't autoplay
            if (reducedMotion.matches || slowConnection) showBtn();

            // Toggle on click
            btn.addEventListener("click", () => {
                if (video.paused) {
                    tryPlay();
                } else {
                    video.pause();
                    showBtn();
                }
            });

            // Start loading when near viewport (200% margin),
            // play/pause when actually visible (25% threshold)
            const observer = new IntersectionObserver(
                ([entry]) => {
                    inView = entry.isIntersecting;
                    if (inView && !reducedMotion.matches && !slowConnection) {
                        tryPlay();
                    } else if (!inView && !video.paused) {
                        video.pause();
                        if (reducedMotion.matches) showBtn();
                    }
                },
                { threshold: 0.25, rootMargin: "200% 0px" },
            );
            observer.observe(video);

            // React to live preference changes
            reducedMotion.addEventListener("change", () => {
                if (reducedMotion.matches) {
                    video.pause();
                    showBtn();
                } else if (inView) {
                    tryPlay();
                }
            });
        });
    }

    initProjectVideos();
    document.addEventListener("astro:after-swap", initProjectVideos);
</script>
