---
import { Picture } from "astro:assets";
import { Heading, Text, Link, Flex } from "@radix-ui/themes";
import type { ImageMetadata } from "astro";

interface Props {
    title: string;
    year: string;
    link?: string;
    description?: string;
    images?: ImageMetadata[];
    alts: string[];
}

const { title, year, link, description, images, alts } = Astro.props;
---

<article>
    <Flex direction="column" gap="2" justify="start">
        {
            link ? (
                <Heading as="h3" size="4" weight="medium" highContrast>
                    <Link
                        href={link}
                        target={link.startsWith("http") ? "_blank" : undefined}
                        rel={
                            link.startsWith("http")
                                ? "noopener noreferrer"
                                : undefined
                        }
                    >
                        {title}
                    </Link>
                </Heading>
            ) : (
                <Heading as="h3" size="4" weight="medium" highContrast>
                    {title}
                </Heading>
            )
        }
        <Text size="2" color="gray">{year}</Text>

        {
            description && (
                <Text
                    size="3"
                    as="p"
                    weight="regular"
                    wrap="pretty"
                    style={{ maxWidth: "80ch" }}
                >
                    {description}
                </Text>
            )
        }

        {
            images && images.length > 0 && (
                <div class="carousel-wrapper" data-count={images.length}>
                    <figure class="playground-carousel">
                        {images.map((image, i) => (
                            <Picture
                                src={image}
                                alt={alts[i] || ""}
                                formats={["avif", "webp"]}
                                loading="lazy"
                                decoding="async"
                            />
                        ))}
                    </figure>
                    {images.length > 1 && (
                        <div class="carousel-controls" aria-hidden="true">
                            <button
                                class="carousel-btn carousel-btn--prev"
                                type="button"
                                aria-label="Previous image"
                            >
                                <svg
                                    width="16"
                                    height="16"
                                    viewBox="0 0 16 16"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M10 3L5 8L10 13"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </button>
                            <button
                                class="carousel-btn carousel-btn--next"
                                type="button"
                                aria-label="Next image"
                            >
                                <svg
                                    width="16"
                                    height="16"
                                    viewBox="0 0 16 16"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M6 3L11 8L6 13"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </button>
                        </div>
                    )}
                </div>
            )
        }
    </Flex>
</article>

<script>
    document
        .querySelectorAll<HTMLElement>(".carousel-wrapper")
        .forEach((wrapper) => {
            const carousel = wrapper.querySelector<HTMLElement>(
                ".playground-carousel",
            );
            if (!carousel) return;

            wrapper
                .querySelector(".carousel-btn--prev")
                ?.addEventListener("click", () => {
                    const imgWidth =
                        carousel.querySelector("picture")?.clientWidth ?? 300;
                    carousel.scrollBy({
                        left: -(imgWidth + 12),
                        behavior: "smooth",
                    });
                });

            wrapper
                .querySelector(".carousel-btn--next")
                ?.addEventListener("click", () => {
                    const imgWidth =
                        carousel.querySelector("picture")?.clientWidth ?? 300;
                    carousel.scrollBy({
                        left: imgWidth + 12,
                        behavior: "smooth",
                    });
                });
        });
</script>
