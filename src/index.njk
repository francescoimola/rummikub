{% from "_carousel.njk" import carousel %}
{% from "_project-item.njk" import projectItem %}
{# Line breaks and the two indented lines are the design; each span is one line of the KC hero #}
<header class="home-hero">
  <h1><span>big-idea</span> <span class="home-hero__indent">person?</span> <span>let’s get</span> <span>your big ideas</span> <span class="home-hero__indent">across</span></h1>
</header>

<section class="section" aria-label="Introduction">
  <div class="flow has-gap-s">
    <p class="home-intro__statement">I'm Francesco Imola, a designer, marketer, and artist based in Folkestone, Kent.</p>
    <img class="home-intro__photo" src="/assets/images/francesco.png" alt="Francesco Imola, smiling in front of a flowering hedge">
  </div>
  <div class="flow has-gap-s">
    <p>I help brands with big missions stop chasing novelties and start rethinking their fundamentals. My bread and butter are websites, UX, UI, copywriting, brand messaging, and graphic design.</p>
    <p>In other words, if people don't get what you do, I rewrite it; if they can't work out how to buy, I redesign it; and if they can't tell you from the guys next door, I find what makes you different and say it loud.</p>
    <p>When I’m not resuscitating brands from the brink of death, I make art and work with up and coming artists.</p>
    <a href="/about/" data-icon="arrow-right">More about me</a>
  </div>
</section>

<section class="home-block flow has-gap-s-m" aria-labelledby="case-studies">
  <h2 id="case-studies">Featured</h2>
  {% for project in collections.workFeatured %}
    {{ projectItem(project.data.title, project.data.services, project.data.image, project.data.alt, project.url or "") }}
  {% endfor %}
</section>

{# Shown only once Explorations has entries in Pages CMS #}
