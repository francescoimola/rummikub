---
pagination:
  data: collections.writingTypes
  size: 1
  alias: type
permalink: "/writing/{{ type }}/"
layout: _base.njk
contentMode: contrast
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ writingTypes[type].label }}"
  description: "{{ writingTypes[type].blurb }}"
---
{% from "_writing-item.njk" import writingItem %}
{% set t = writingTypes[type] %}
  <header class="card flow has-gap-s has-items-center has-text-center" view-animation="settle">
    {% icon t.icon %}
    <div class="flow has-gap-xs has-items-center has-text-center balance">
      <h1>{{ t.label }}</h1>
      <hr>
      <small class="dimmed">{{ t.blurb }}</small>
    </div>
  </header>

  <div class="flow has-gap-xs{% if type == 'notes' %} writing-section--quiet{% endif %}">
    {% for item in collections.writing | byType(type) %}
      {{ writingItem(item) }}
    {% endfor %}
  </div>

  <small><a href="/writing/">← All writing</a></small>
