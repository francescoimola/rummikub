---
pagination:
  data: collections.writingTypes
  size: 1
  alias: typeSlug
  addAllPagesToCollections: true
permalink: "/writing/{{ typeSlug }}/"
layout: _base.njk
eleventyComputed:
  title: "{{ writingTypes[typeSlug].label }}"
  metaTitle: "{{ writingTypes[typeSlug].metaTitle }}"
  description: "{{ writingTypes[typeSlug].metaDescription }}"
  eleventyNavigation:
    key: "{{ typeSlug }}" 
    parent: Writing
---

{% from "_writing-item.njk" import writingItem %}
{% set t = writingTypes[typeSlug] %}
  <header class="flow has-gap-xs balance">
    <h1>{{ t.label }}</h1>
    <p class="dimmed">{{ t.blurb }}</p>
    {% include "_breadcrumb.njk" %}
  </header>
  <div class="flow has-gap-xs{% if typeSlug == 'notes' %} writing-section--quiet{% endif %}">
    {% set items = collections.writing | byType(typeSlug) %}
    {% set thumbColors = items | writingThumbColors %}
    {% for item in items %}
      {{ writingItem(item, thumbColors[loop.index0]) }}
    {% endfor %}
  </div>

  <small><a href="/writing/">← All writing</a></small>
