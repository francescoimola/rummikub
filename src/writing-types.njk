---
pagination:
  data: collections.writingTypes
  size: 1
  alias: typeSlug
  addAllPagesToCollections: true
permalink: "/writing/{{ typeSlug }}/"
layout: _base.njk
contentMode: contrast
eleventyComputed:
  title: "{{ writingTypes[typeSlug].label }}"
  description: "{{ writingTypes[typeSlug].blurb }}"
  eleventyNavigation:
    key: "{{ typeSlug }}" 
    parent: Writing
---

{% from "_writing-item.njk" import writingItem %}
{% set t = writingTypes[typeSlug] %}
  <header class="card flow has-gap-s has-items-center has-text-center" view-animation="settle">
    {% icon t.icon %}
    <div class="flow has-gap-xs has-items-center has-text-center balance">
      {% include "_breadcrumb.njk" %}
      <h1>{{ t.label }}</h1>
      <hr>
      <small class="dimmed">{{ t.blurb }}</small>
    </div>
  </header>

  <div class="flow has-gap-xs{% if typeSlug == 'notes' %} writing-section--quiet{% endif %}">
    {% for item in collections.writing | byType(typeSlug) %}
      {{ writingItem(item) }}
    {% endfor %}
  </div>

  <small><a href="/writing/">← All writing</a></small>
