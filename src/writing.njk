---
layout: _base.njk
title: Drawing my own conclusions | Blog | Francesco Imola
description: Guides, essays and notes on design, copywriting and running a small business. Practical where it helps, honest where it doesn't. Have a read.
eleventyNavigation:
  key: Writing
  title: Ideas
  parent: Home
---
{% from "_writing-item.njk" import writingItem %}
{% from "_page-header.njk" import pageHeader %}
  {{ pageHeader("meditating", "Drawing my own conclusions") }}

  {% for typeSlug in collections.writingTypes %}
  {% set t = writingTypes[typeSlug] %}
  <section class="section">
    <h2>{{ t.short }}</h2>
    <div class="flow has-gap-s">
      <p class="dimmed balance">{{ t.blurb }}</p>
      {% set items = collections.writing | byType(typeSlug) | limit(3) %}
      {% set thumbColors = items | writingThumbColors %}
      {% for item in items %}
        {{ writingItem(item, thumbColors[loop.index0]) }}
      {% endfor %}
      <a href="/writing/{{ typeSlug }}/" data-icon="arrow-right">See all {{ t.short }}</a>
    </div>
  </section>
  {% endfor %}
