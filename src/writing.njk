---
layout: _base.njk
title: Writing
contentMode: contrast
description: Guides, essays and notes on design, copywriting and running a business.
eleventyNavigation:
  key: Writing
  parent: Home
---
{% from "_writing-item.njk" import writingItem %}
  <header class="card flow has-gap-s has-items-center has-text-center" view-animation="settle">
    {% icon "meditating" %}
    <div class="flow has-gap-xs has-items-center has-text-center balance">
      <h1>Drawing my own conclusions</h1>
      <hr style="max-inline-size: 50%;">
      <small class="dimmed" style="max-inline-size: calc(4*var(--space-4xl));">Yet another blog on the web</small>
    </div>
  </header>

  {% for typeSlug in collections.writingTypes %}
  {% set t = writingTypes[typeSlug] %}
  <section class="flow has-gap-m writing-section{% if typeSlug == 'notes' %} writing-section--quiet{% endif %}">
    <div class="flow has-gap-2xs balance">
      <h2>{{ t.short}}</h2>
      <p class="dimmed">{{ t.blurb }}</p>
    </div>
    <div class="flow has-gap-xs">
      {% for item in collections.writing | byType(typeSlug) | limit(2) %}
        {{ writingItem(item) }}
      {% endfor %}
    </div>
   <a href="/writing/{{ typeSlug }}/" data-icon="arrow-right">See all {{ t.short | capitalize }}</a>
  </section>
  {% endfor %}
